<style>
    /* 画面下に固定し、閉じているときは画面外へ下げておく */
    .custom-keypad-container {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background-color: #1a261a;
        border-top: 2px solid #2e7d32;
        z-index: 1000;
        transform: translateY(100%);
        transition: transform 0.2s ease-out;
        padding: 8px 12px 24px 12px;
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.6);
        box-sizing: border-box;
    }

    .custom-keypad-container.open {
        transform: translateY(0);
    }

    .keypad-table {
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
        border-collapse: separate;
        border-spacing: 6px;
        table-layout: fixed;
    }

    .keypad-btn {
        width: 100%;
        height: 48px;
        font-size: 1.2rem;
        font-weight: bold;
        border-radius: 8px;
        background-color: rgba(255, 255, 255, 0.06);
        color: #e0e0e0;
        border: none;
        outline: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
        white-space: nowrap;
        /* iOS: タップ時のハイライト・長押しでの文字選択やメニューを出さない */
        -webkit-tap-highlight-color: transparent;
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
    }

    .keypad-btn:active {
        background-color: rgba(255, 255, 255, 0.18);
    }

    .keypad-btn.op-key {
        background-color: #2e7d32;
        color: white;
    }

    .keypad-btn.op-key:active {
        background-color: #1b5e20;
    }

    .keypad-btn.action-key {
        background-color: #b71c1c;
        color: white;
    }

    .keypad-btn.action-key:active {
        background-color: #7f0000;
    }

    .keypad-btn.record-key {
        background-color: #ff9800 !important;
        color: white !important;
        font-weight: bold;
        animation: keypad-pulse-border 1.5s infinite;
    }

    .keypad-btn.record-key:active {
        background-color: #e65100 !important;
    }

    @@keyframes keypad-pulse-border {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 152, 0, 0.7);
        }

        70% {
            box-shadow: 0 0 0 6px rgba(255, 152, 0, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255, 152, 0, 0);
        }
    }
</style>

@* iOS は click のときに指の接地範囲で最寄りのボタンへ補正するため、下のキーが反応しやすい。
   補正のない pointerdown で入力し、touchend の preventDefault で後に来る click を止める。
   ontouchstart="" は iOS で :active を効かせるためのもの *@
<div class="@($"custom-keypad-container {(IsOpen ? "open" : "")}")" @onclick:stopPropagation="true" @ontouchend:preventDefault="true" ontouchstart="">
    <table class="keypad-table">
        <tr>
            <td><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "1")' @onpointerdown:preventDefault="true">1</button></td>
            <td><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "2")' @onpointerdown:preventDefault="true">2</button></td>
            <td><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "3")' @onpointerdown:preventDefault="true">3</button></td>
            <td><button type="button" class="keypad-btn action-key" @onpointerdown='e => Press(e, "⌫")' @onpointerdown:preventDefault="true">⌫</button></td>
        </tr>
        <tr>
            <td><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "4")' @onpointerdown:preventDefault="true">4</button></td>
            <td><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "5")' @onpointerdown:preventDefault="true">5</button></td>
            <td><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "6")' @onpointerdown:preventDefault="true">6</button></td>
            <td><button type="button" class="keypad-btn op-key" @onpointerdown='e => Press(e, "+")' @onpointerdown:preventDefault="true">＋</button></td>
        </tr>
        <tr>
            <td><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "7")' @onpointerdown:preventDefault="true">7</button></td>
            <td><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "8")' @onpointerdown:preventDefault="true">8</button></td>
            <td><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "9")' @onpointerdown:preventDefault="true">9</button></td>
            <td><button type="button" class="keypad-btn op-key" @onpointerdown='e => Press(e, "-")' @onpointerdown:preventDefault="true">ー</button></td>
        </tr>
        <tr>
            <td><button type="button" class="keypad-btn action-key" @onpointerdown='e => Press(e, "C")' @onpointerdown:preventDefault="true">C</button></td>
            <td colspan="2"><button type="button" class="keypad-btn" @onpointerdown='e => Press(e, "0")' @onpointerdown:preventDefault="true">0</button></td>
            <td>
                @if (ShowRecordButton && IsTotalCorrect)
                {
                    <button type="button" class="keypad-btn record-key" @onpointerdown='e => Press(e, "記録")' @onpointerdown:preventDefault="true">@RecordLabel</button>
                }
                else
                {
                    <button type="button" class="keypad-btn op-key" @onpointerdown='e => Press(e, "閉じる")' @onpointerdown:preventDefault="true">閉じる</button>
                }
            </td>
        </tr>
    </table>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsTotalCorrect { get; set; }
    [Parameter] public bool ShowRecordButton { get; set; } = true;
    [Parameter] public string RecordLabel { get; set; } = "記録"; // 表示のみ。送るキーは常に "記録"
    [Parameter] public EventCallback<string> OnKeyPress { get; set; }

    // 左クリックとタッチだけ受け付ける（右クリックは無視する）
    private Task Press(PointerEventArgs e, string key)
        => e.Button == 0 ? OnKeyPress.InvokeAsync(key) : Task.CompletedTask;
}