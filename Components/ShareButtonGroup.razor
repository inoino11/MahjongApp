@using MahjongApp.Models
@using System.Net.Http.Json
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IDialogService DialogService
@inject MahjongApp.Services.LiveShareService LiveShare
@implements IDisposable

<div class="d-flex justify-end mt-4 gap-2">
    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Image" OnClick="ShareImageAsync" Disabled="@(isSharing || ActiveHistory.Count == 0)" Style="flex: 1; max-width: 140px; white-space: nowrap;">
        @(isSharing ? "生成中..." : "画像シェア")
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Link" OnClick="CopyShareUrlAsync" Disabled="@(isSharing || ActiveHistory.Count == 0)" Style="flex: 1; max-width: 140px; white-space: nowrap;">
        @(isSharing ? "生成中..." : "URLシェア")
    </MudButton>
    @if (!LiveShare.IsActive)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.LiveTv" OnClick="StartLiveAsync" Disabled="@isSharing" Style="flex: 1; max-width: 140px; white-space: nowrap;">
            観戦URL
        </MudButton>
    }
    else
    {
        <div style="flex: 1; max-width: 140px;">
            <MudMenu Label="@(LiveShare.HasError ? "更新失敗" : "LIVE")" StartIcon="@(LiveShare.HasError ? Icons.Material.Filled.SyncProblem : Icons.Material.Filled.Sensors)" Variant="Variant.Filled" Color="@(LiveShare.HasError ? Color.Warning : Color.Error)" Size="Size.Small" FullWidth="true" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight">
                <MudMenuItem Icon="@Icons.Material.Filled.Share" OnClick="ShareLiveUrlAsync">URLを共有</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Sync" OnClick="UpdateLiveNowAsync">今すぐ更新</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.StopCircle" OnClick="StopLiveAsync">配信を停止</MudMenuItem>
            </MudMenu>
        </div>
    }
</div>

<ShareTarget 
    TargetId="@targetId" Rules="Rules" TablePlayers="TablePlayers" ActiveHistory="ActiveHistory" ActiveSessionChips="ActiveSessionChips" />

@code {
    [CascadingParameter] public CurrencySetting Currency { get; set; } = new();
    [Parameter] public RuleSet Rules { get; set; } = new();
    [Parameter] public List<string> TablePlayers { get; set; } = new();
    [Parameter] public List<GameResult> ActiveHistory { get; set; } = new();
    [Parameter] public Dictionary<string, int> ActiveSessionChips { get; set; } = new();

    private string targetId = $"share-target-{Guid.NewGuid():N}";
    private bool isSharing = false;
    private readonly string workerUrl = "https://mahjong-share.inoino11.workers.dev";

    private string? cachedShareUrl = null;
    private string lastPayloadJson = "";

    protected override async Task OnInitializedAsync()
    {
        await LiveShare.EnsureLoadedAsync();
        LiveShare.OnChanged += HandleLiveChanged;
    }

    private void HandleLiveChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LiveShare.OnChanged -= HandleLiveChanged;

    // --- 観戦URL ---
    private async Task StartLiveAsync()
    {
        isSharing = true;
        StateHasChanged();
        try
        {
            string payloadJson = System.Text.Json.JsonSerializer.Serialize(CreatePayloadObject());
            await LiveShare.StartAsync(payloadJson);
            Snackbar.Add("観戦URLを発行しました\n記録するたびに自動で更新されます", Severity.Success);
            await ShareLiveUrlAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"観戦URLの発行に失敗しました:\n{ex.Message}", Severity.Error);
        }
        finally
        {
            isSharing = false;
            StateHasChanged();
        }
    }

    private async Task ShareLiveUrlAsync()
    {
        if (LiveShare.ShareUrl == null) return;
        string shareResult = await JSRuntime.InvokeAsync<string>("shareUrlNative", "麻雀集計ツール - 観戦", LiveShare.ShareUrl);
        if (shareResult == "COPIED") Snackbar.Add("観戦URLをクリップボードにコピーしました", Severity.Success);
        else if (shareResult.StartsWith("ERROR")) Snackbar.Add("共有またはコピーに失敗しました", Severity.Error);
    }

    private async Task UpdateLiveNowAsync()
    {
        bool ok = await LiveShare.UpdateNowAsync();
        if (ok) Snackbar.Add("観戦URLを更新しました", Severity.Success);
        else if (LiveShare.IsActive) Snackbar.Add("観戦URLの更新に失敗しました\n通信状況を確認してください", Severity.Warning);
        else Snackbar.Add("観戦URLの有効期限が切れています\n新しく発行してください", Severity.Warning);
    }

    private async Task StopLiveAsync()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "配信の停止",
            (MarkupString)"観戦URLの更新を停止しますか？<br /><span style='font-size: 0.85rem; color: var(--mud-palette-text-secondary);'>※停止時点の結果は、このURLで90日間見られます。</span>",
            yesText: "停止する", cancelText: "キャンセル");
        if (result != true) return;
        string payloadJson = System.Text.Json.JsonSerializer.Serialize(CreatePayloadObject());
        await LiveShare.EndAsync("stopped", payloadJson);
        Snackbar.Add("観戦URLの配信を停止しました", Severity.Info);
    }

    protected override void OnParametersSet()
    {
        var currentPayloadJson = System.Text.Json.JsonSerializer.Serialize(CreatePayloadObject());
        if (currentPayloadJson != lastPayloadJson)
        {
            cachedShareUrl = null;
            lastPayloadJson = currentPayloadJson;
        }
    }

    private object CreatePayloadObject() => SharePayloadBuilder.Build(Rules, TablePlayers, ActiveHistory, ActiveSessionChips, Currency);

    private async Task ShareImageAsync()
    {
        isSharing = true;
        StateHasChanged();
        await Task.Delay(50);
        try
        {
            var result = await JSRuntime.InvokeAsync<string>("exportAndShareResult", targetId);
            if (result == "COPIED") Snackbar.Add("画像をクリップボードにコピーしました", Severity.Success);
            else if (result == "DOWNLOADED") Snackbar.Add("画像をダウンロードしました", Severity.Info);
            else if (result.StartsWith("ERROR")) Snackbar.Add($"画像の生成に失敗しました:\n{result}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("シェア処理中にエラーが発生しました", Severity.Error);
        }
        finally
        {
            isSharing = false;
            StateHasChanged();
        }
    }

    private async Task CopyShareUrlAsync()
    {
        isSharing = true;
        StateHasChanged();
        try
        {
            if (!string.IsNullOrEmpty(cachedShareUrl))
            {
                string shareResult = await JSRuntime.InvokeAsync<string>("shareUrlNative", "麻雀集計ツール - 対局結果", cachedShareUrl);
                if (shareResult == "COPIED") Snackbar.Add("閲覧用URLをクリップボードにコピーしました", Severity.Success);
                else if (shareResult.StartsWith("ERROR")) Snackbar.Add("共有またはコピーに失敗しました", Severity.Error);
                return;
            }

            string rawJson = System.Text.Json.JsonSerializer.Serialize(CreatePayloadObject());

            var cryptoRes = await JSRuntime.InvokeAsync<CryptoResult>("blazorCrypto.encrypt", rawJson);

            // サーバーには暗号文だけを送り、鍵はURLの # 以降に付ける
            var postPayload = new { encryptedData = cryptoRes.CombinedBase64 };
            
            var response = await Http.PostAsJsonAsync(workerUrl, postPayload);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<WorkerResponse>();
                if (result != null && !string.IsNullOrEmpty(result.Id))
                {
                    cachedShareUrl = $"{NavigationManager.BaseUri}shared?id={result.Id}#{cryptoRes.KeyUrlSafeBase64}";
                    
                    string shareResult = await JSRuntime.InvokeAsync<string>("shareUrlNative", "麻雀集計ツール - 対局結果", cachedShareUrl);
                    if (shareResult == "COPIED") Snackbar.Add("閲覧用URLをクリップボードにコピーしました", Severity.Success);
                    else if (shareResult.StartsWith("ERROR")) Snackbar.Add("共有またはコピーに失敗しました", Severity.Error);
                }
            }
            else
            {
                Snackbar.Add("短縮URLの生成に失敗しました", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"URLの生成に失敗しました:\n{ex.Message}", Severity.Error);
        }
        finally
        {
            isSharing = false;
            StateHasChanged();
        }
    }

    // blazorCrypto.encrypt の戻り値
    public class CryptoResult
    {
        public string CombinedBase64 { get; set; } = "";
        public string KeyUrlSafeBase64 { get; set; } = "";
    }

    public class WorkerResponse
    {
        public string Id { get; set; } = string.Empty;
    }
}