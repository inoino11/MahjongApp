@inherits LayoutComponentBase
@using MahjongApp.Pages
@inject MahjongApp.Services.StatsCacheService StatsCache
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IDialogService DialogService

<MudThemeProvider Theme="@mahjongTheme" IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@* 正負のカラーをアプリ全体に適用するCSS変数 *@
<style>
    :root {
        --color-positive:
            @(_isColorInverted
            ?
"#1e88e5" :
"#e53935")
        ;
        --color-negative:
            @(_isColorInverted
            ?
"#e53935" :
"#1e88e5")
        ;
    }
</style>

<CascadingValue Value="_currencySetting">
    <MudLayout>
        <MudAppBar Elevation="1" Dense="true">
            @if (!IsSharedPage)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            }
            <MudText Typo="Typo.h6" Class="ml-3" Style="font-weight: bold; letter-spacing: 1px;">
                TaGAMΣ <span style="font-size: 0.75rem; font-weight: normal; opacity: 0.8; letter-spacing: normal;">- 麻雀集計 -</span>
            </MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.ChangeCircle" Color="Color.Inherit" Title="単位設定" OnClick="OpenCurrencyDialog" />            
            <MudToggleIconButton Toggled="_isColorInverted" ToggledChanged="OnColorInvertChanged" Icon="@Icons.Material.Filled.InvertColors" Color="Color.Error" Title="正負のカラー設定" ToggledIcon="@Icons.Material.Filled.InvertColors" ToggledColor="Color.Info" ToggledTitle="正負のカラー設定" />
            <MudToggleIconButton Toggled="_isDarkMode" ToggledChanged="OnDarkModeChanged" Icon="@Icons.Material.Filled.DarkMode" Color="Color.Inherit" Title="ダークモードへ" ToggledIcon="@Icons.Material.Filled.LightMode" ToggledColor="Color.Inherit" ToggledTitle="ライトモードへ" />
        </MudAppBar>
        @if (!IsSharedPage)
        {
            <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Width="160px">
                <NavMenu />
            </MudDrawer>
        }
        <MudMainContent>
            @Body
        </MudMainContent>
    </MudLayout>
</CascadingValue>

@code {
    bool _drawerOpen = false;
    bool _isDarkMode = true;
    bool IsSharedPage = false;
    bool _isColorInverted = false;
    private CurrencySetting _currencySetting = new();

    protected override void OnInitialized()
    {
        CheckIfSharedPage(NavManager.Uri);
        NavManager.LocationChanged += (s, e) =>
        {
            CheckIfSharedPage(e.Location);
            StateHasChanged();
        };
    }

    // URLに "/shared" が含まれているか判定
    private void CheckIfSharedPage(string uri)
    {
        IsSharedPage = uri.Contains("/shared");
    }

    // 起動直後に裏で中間構造体を作成
    protected override async Task OnInitializedAsync()
    {
        _ = StatsCache.InitializeAsync();
        _isColorInverted = await LocalStorage.GetItemAsync<bool>("isColorInverted");
        var savedDarkMode = await LocalStorage.GetItemAsync<bool?>("isDarkMode");
        _isDarkMode = savedDarkMode ?? true;
        var savedCurrency = await LocalStorage.GetItemAsync<CurrencySetting>("currencySetting");
        if (savedCurrency != null) _currencySetting = savedCurrency;
        StateHasChanged();
    }

    // ダイアログを開き、設定を保存する処理
    private async Task OpenCurrencyDialog()
    {
        var parameters = new DialogParameters { ["CurrentSetting"] = _currencySetting };
        var dialog = await DialogService.ShowAsync<CurrencyDialog>("表示単位の設定", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is CurrencySetting newSetting)
        {
            _currencySetting = newSetting;
            await LocalStorage.SetItemAsync("currencySetting", _currencySetting);
            StateHasChanged(); // アプリ全体を再レンダリング
        }
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    // 既存の動きに合わせて少し待機してからロード画面を消す
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            await JSRuntime.InvokeVoidAsync("hideMahjongLoader");
        }
    }

    // ボタンが押された時の処理
    private async Task OnColorInvertChanged(bool newValue)
    {
        _isColorInverted = newValue;
        await LocalStorage.SetItemAsync("isColorInverted", newValue);
    }

    private async Task OnDarkModeChanged(bool newValue)
    {
        _isDarkMode = newValue;
        await LocalStorage.SetItemAsync("isDarkMode", newValue);
    }

    private MudTheme mahjongTheme = new MudTheme()
    {
        // --- ライトモード設定（以前の設定を維持） ---
        PaletteLight = new PaletteLight()
        {
            Primary = "#1b5e20", // 深緑
            Secondary = "#b71c1c", // 赤
            Background = "#2e7d32", // 鮮やかな緑（雀卓）
            Surface = "#ffffff", // 白
            TextPrimary = "#000000",
            AppbarBackground = "#1b5e20",
        },

        // --- ダークモード設定（シックな黒緑スタイル） ---
        PaletteDark = new PaletteDark()
        {
            Primary = "#81c784", // 明るめの緑（ボタン等）
            Secondary = "#ef5350", // 明るめの赤（削除ボタン等）
            Background = "#0d140d", // 背景：黒に近い深い緑
            Surface = "#1a261a", // カード：少しだけ明るい黒緑（雀卓の質感をイメージ）
            AppbarBackground = "#081008", // バー：さらに暗い緑
            TextPrimary = "#e0e0e0", // 文字：少しグレーがかった白（まぶしさを抑制）
            TextSecondary = "#b0b0b0",
            ActionDefault = "#81c784",
            DrawerBackground = "#121d12", // ドロワー：背景に近い深い緑
            Divider = "#2e3b2e", // 区切り線
            TableStriped = "rgba(255,255,255,0.02)"
        }
    };
}