@inherits LayoutComponentBase
@inject MahjongApp.Services.StatsCacheService StatsCache
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IDialogService DialogService
@inject MahjongApp.Services.CloudBackupService CloudBackup

<MudThemeProvider Theme="@mahjongTheme" IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@* 正負の色（反転設定に従う）をアプリ全体の CSS 変数にする *@
<style>
    :root {
        --color-positive:
            @(_isColorInverted
            ?
"#1e88e5" :
"#e53935")
        ;
        --color-negative:
            @(_isColorInverted
            ?
"#e53935" :
"#1e88e5")
        ;
    }
</style>

<CascadingValue Value="_currencySetting">
    <MudLayout>
        <MudAppBar Elevation="1" Dense="true">
            @if (!IsSharedPage)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            }
            <MudText Typo="Typo.h6" Class="ml-3" Style="font-weight: bold; letter-spacing: 1px;">
                TaGAMΣ <span style="font-size: 0.75rem; font-weight: normal; opacity: 0.8; letter-spacing: normal;">- 麻雀集計 -</span>
            </MudText>
            <MudSpacer />
            <div class="d-flex align-center gap-2">
                <MudIconButton Class="mx-n1" Style="padding: 8px;" Icon="@Icons.Material.Filled.ChangeCircle" Color="Color.Inherit" title="単位設定" OnClick="OpenCurrencyDialog" />
                <MudToggleIconButton Class="mx-n1" Style="padding: 8px;" Toggled="_isColorInverted" ToggledChanged="OnColorInvertChanged" Icon="@Icons.Material.Filled.InvertColors" Color="Color.Error" title="正負のカラー設定" ToggledIcon="@Icons.Material.Filled.InvertColors" ToggledColor="Color.Info" />
                <MudToggleIconButton Class="mx-n1" Style="padding: 8px;" Toggled="_isDarkMode" ToggledChanged="OnDarkModeChanged" Icon="@Icons.Material.Filled.DarkMode" Color="Color.Inherit" title="@(_isDarkMode ? "ライトモードへ" : "ダークモードへ")" ToggledIcon="@Icons.Material.Filled.LightMode" ToggledColor="Color.Inherit" />
            </div>
        </MudAppBar>
        @if (!IsSharedPage)
        {
            <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Width="160px">
                <NavMenu />
            </MudDrawer>
        }
        <MudMainContent>
            @* 画面内で例外が起きてもヘッダー・メニューは残し、他画面へ移動・復帰できるようにする *@
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: bold;">エラーが発生しました</MudText>
                            <MudText Typo="Typo.body2" Class="mt-1">入力中のデータは保存されています。トップに戻るか、再読み込みしてください。</MudText>
                        </MudAlert>
                        <div class="d-flex gap-2 mt-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RecoverToTop">トップに戻る</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReloadApp">再読み込み</MudButton>
                        </div>
                    </MudContainer>
                </ErrorContent>
            </ErrorBoundary>
        </MudMainContent>
    </MudLayout>
</CascadingValue>

@code {
    bool _drawerOpen = false;
    bool _isDarkMode = true;
    bool IsSharedPage = false;
    bool _isColorInverted = false;
    private CurrencySetting _currencySetting = new();

    protected override void OnInitialized()
    {
        CheckIfSharedPage(NavManager.Uri);
        NavManager.LocationChanged += (s, e) =>
        {
            CheckIfSharedPage(e.Location);
            _errorBoundary?.Recover(); // 画面を移動したらエラー表示を解除する
            StateHasChanged();
        };
    }

    private ErrorBoundary? _errorBoundary;

    private void RecoverToTop()
    {
        _errorBoundary?.Recover();
        NavManager.NavigateTo("");
    }

    private void ReloadApp() => NavManager.NavigateTo(NavManager.Uri, forceLoad: true);

    // 共有・観戦ページ（/shared）ではメニューを出さない
    private void CheckIfSharedPage(string uri)
    {
        IsSharedPage = uri.Contains("/shared");
    }

    // 成績の集計とクラウドバックアップの送り残しの確認は、起動直後から裏で始めておく
    protected override async Task OnInitializedAsync()
    {
        _ = StatsCache.InitializeAsync();
        _ = CloudBackup.InitializeAsync();
        var savedColorInverted = await SafeGetAsync<bool?>(StorageKeys.IsColorInverted);
        _isColorInverted = savedColorInverted ?? true;
        var savedDarkMode = await SafeGetAsync<bool?>(StorageKeys.IsDarkMode);
        _isDarkMode = savedDarkMode ?? true;
        var savedCurrency = await SafeGetAsync<CurrencySetting>(StorageKeys.CurrencySetting);
        if (savedCurrency != null) _currencySetting = savedCurrency;
        await ApplyThemeColorAsync();
        StateHasChanged();
    }

    // Android の PWA はステータスバーを theme-color で塗るため、ヘッダーの色に合わせる
    private async Task ApplyThemeColorAsync()
    {
        string color = _isDarkMode ? mahjongTheme.PaletteDark.AppbarBackground.ToString() : mahjongTheme.PaletteLight.AppbarBackground.ToString();
        await JSRuntime.InvokeVoidAsync("setThemeColor", color);
    }

    // 表示設定が読めなくても（保存形式の変更・破損など）初期値で起動を続ける
    private async Task<T?> SafeGetAsync<T>(string key)
    {
        try
        {
            return await LocalStorage.GetItemAsync<T>(key);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"localStorage '{key}' の読み込みに失敗しました: {ex.Message}");
            return default;
        }
    }

    private async Task OpenCurrencyDialog()
    {
        var parameters = new DialogParameters { ["CurrentSetting"] = _currencySetting };
        var dialog = await DialogService.ShowAsync<CurrencyDialog>("表示単位の設定", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is CurrencySetting newSetting)
        {
            _currencySetting = newSetting;
            await LocalStorage.SetItemAsync(StorageKeys.CurrencySetting, _currencySetting);
            StateHasChanged(); // CascadingValue 経由でアプリ全体の表示を更新する
        }
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    // 初回描画後、少し待ってからローディング画面を消す（描画途中の画面が見えないように）
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            await JSRuntime.InvokeVoidAsync("hideMahjongLoader");
        }
    }

    private async Task OnColorInvertChanged(bool newValue)
    {
        _isColorInverted = newValue;
        await LocalStorage.SetItemAsync(StorageKeys.IsColorInverted, newValue);
    }

    private async Task OnDarkModeChanged(bool newValue)
    {
        _isDarkMode = newValue;
        await LocalStorage.SetItemAsync(StorageKeys.IsDarkMode, newValue);
        await ApplyThemeColorAsync();
    }

    private MudTheme mahjongTheme = new MudTheme()
    {
        // --- ライトモード（雀卓の緑） ---
        PaletteLight = new PaletteLight()
        {
            Primary = "#1b5e20",
            Secondary = "#b71c1c",
            Background = "#2e7d32",
            Surface = "#ffffff",
            TextPrimary = "#000000",
            AppbarBackground = "#1b5e20",
            Success = "#2e7d32", // 白背景上の文字・白文字ボタンでも読める濃さ
        },

        // --- ダークモード（黒に近い緑） ---
        PaletteDark = new PaletteDark()
        {
            Primary = "#81c784",
            PrimaryContrastText = "#0d140d", // 明るい緑の塗りボタン上は濃い文字にする
            SuccessContrastText = "#0d140d",
            Secondary = "#ef5350",
            Background = "#0d140d",
            Surface = "#1a261a",
            AppbarBackground = "#081008",
            TextPrimary = "#e0e0e0", // 真っ白はまぶしいので少し落とす
            TextSecondary = "#b0b0b0",
            ActionDefault = "#81c784",
            DrawerBackground = "#121d12",
            Divider = "#2e3b2e",
            TableStriped = "rgba(255,255,255,0.02)"
        }
    };
}