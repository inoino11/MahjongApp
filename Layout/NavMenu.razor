@using System.Reflection
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@implements IDisposable

<div style="display: flex; flex-direction: column; height: 100%;">
    <MudNavMenu>
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Functions">素点集計</MudNavLink>
        <MudNavLink Href="settlement" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payments">場代精算</MudNavLink>
        <MudNavLink Href="sessions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">対局履歴</MudNavLink>
        <MudNavLink Href="dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.QueryStats">通算成績</MudNavLink>
        <MudNavLink Href="players" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">名簿管理</MudNavLink>
        <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">データ管理</MudNavLink>
        <MudNavLink Href="about" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HelpOutline">使い方</MudNavLink>
    </MudNavMenu>
    <div style="margin-top: auto;">
        @* Android・PC: ブラウザのインストール案内を出すボタン *@
        @if (canInstall)
        {
            <div class="px-4 mb-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.InstallMobile" FullWidth="true" OnClick="InstallPwaAsync" Style="font-size: 0.8rem; padding: 4px 8px; border-radius: 8px;">
                    アプリとして追加
                </MudButton>
            </div>
        }
        @* iOS の Safari: インストール案内が出ないため、手順を表示する *@
        @if (envInfo.IsIOS && !envInfo.IsPwa)
        {
            <div class="px-3 mb-2">
                <div Style="font-size: 0.60rem; line-height: 1.4;">
                    共有メニューから「ホーム画面に追加」でアプリ化できますが、<span style="color: var(--mud-palette-warning); font-weight: bold;">ブラウザ側のデータは引き継がれません。</span><br />
                    事前に「データ管理」からバックアップをお願いします。
                </div>
            </div>
        }
        @* バージョン表示（押すと更新を確認する） *@
        <MudButton Variant="Variant.Text" OnClick="CheckForUpdateAsync" Style="color: var(--mud-palette-text-disabled); font-family: monospace; text-transform: none; padding: 4px 8px; min-width: 0; font-size: 0.8rem;" Disabled="@isChecking">
            @if (isChecking)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2 mb-3" />
                <span style="white-space: nowrap;" Class="mb-3">確認中...</span>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" Class="mr-1 mb-3" />
                <span style="white-space: nowrap;" Class="mb-3">@AppVersion</span>
            }
        </MudButton>
    </div>
</div>

@code {
    private string AppVersion { get; set; } = "v--.--.--";
    private bool isChecking = false;
    private bool canInstall = false;
    private EnvironmentInfo envInfo = new();
    private DotNetObjectReference<NavMenu>? objRef;
    protected override void OnInitialized()
    {
        var assembly = Assembly.GetExecutingAssembly();
        var attr = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>();
        if (attr != null) AppVersion = attr.InformationalVersion;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("pwaInstall.init", objRef);
            envInfo = await JSRuntime.InvokeAsync<EnvironmentInfo>("pwaHelper.getEnvironmentInfo");
            StateHasChanged();
        }
    }

    // インストール可能になったとき（wwwroot/js/pwa.js から呼ばれる）
    [JSInvokable]
    public void OnInstallAvailable()
    {
        canInstall = true;
        StateHasChanged();
    }

    // インストールが完了したとき（wwwroot/js/pwa.js から呼ばれる）
    [JSInvokable]
    public void OnInstalled()
    {
        canInstall = false;
        StateHasChanged();
        Snackbar.Add("アプリがインストールされました", Severity.Success);
    }

    private async Task InstallPwaAsync()
    {
        try
        {
            var accepted = await JSRuntime.InvokeAsync<bool>("pwaInstall.prompt");
            if (accepted)
            {
                canInstall = false;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            Snackbar.Add("インストール中にエラーが発生しました", Severity.Error);
        }
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

    private async Task CheckForUpdateAsync()
    {
        isChecking = true;
        StateHasChanged();

        try
        {
            // すぐ結果が出ても、確認した感触が伝わるよう少し待つ
            await Task.Delay(500);
            var result = await JSRuntime.InvokeAsync<string>("checkForUpdate");
            if (result == "CHECKED")
            {
                Snackbar.Add("最新版を確認しました\n新しいバージョンがあれば案内が表示されます", Severity.Info);
            }
            else if (result == "NOT_REGISTERED")
            {
                Snackbar.Add("更新を確認できませんでした\n初回の読み込み中か、対応していないブラウザです", Severity.Warning);
            }
            else
            {
                Snackbar.Add("アップデートの確認に失敗しました", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラーが発生しました:\n{ex.Message}", Severity.Error);
        }
        finally
        {
            isChecking = false;
            StateHasChanged();
        }
    }
}