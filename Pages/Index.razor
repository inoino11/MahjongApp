@page "/"
@implements IDisposable
@inject ILocalStorageService LocalStorage
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject MahjongApp.Services.DatabaseService DatabaseService
@inject MahjongApp.Services.StatsCacheService StatsCache
@inject MahjongApp.Services.SessionStateService SessionState
@inject MahjongApp.Services.MahjongCalculatorService Calculator
@inject MahjongApp.Services.LiveShareService LiveShare

<style>
    .player-name-input input {
        text-align: center !important;
        letter-spacing: 1px;
    }

    /* 入力中でない名前欄は控えめに表示する */
    .player-name-input:not(:focus-within) {
        opacity: 0.85;
    }

    .score-input input {
        text-align: right !important;
        font-size: 1.3rem !important;
        font-weight: 500 !important;
        padding-right: 2px !important;
    }

    .score-input.auto-filled input {
        color: var(--mud-palette-info) !important;
    }

    .score-input.mud-input-control .mud-input-outlined {
        height: 28px !important;
        min-height: 28px !important;
    }

    .score-input.mud-input-control .mud-input-outlined .mud-input-adornment-start {
        margin: 0 !important;
    }

    .score-input.mud-input-control .mud-input-outlined .mud-input-adornment-start svg {
        font-size: 16px !important;
    }

    .score-zeros {
        font-size: 1.3rem;
        font-weight: 500;
        color: #808080;
        margin-left: 2px;
        user-select: none;
    }

    /* 自動入力のアイコンが付いても、文字の高さがずれないようにする */
    .score-input .mud-input {
        align-items: baseline !important;
    }

    /* アイコン自体は高さの中央を維持する */
    .score-input .mud-input-adornment-start {
        align-self: center !important;
        margin-top: 0 !important;
    }

    /* テンキーで入力中の素点欄 */
    .score-input-active {
        border: 1px solid #81c784 !important;
        box-shadow: 0 0 6px rgba(129, 199, 132, 0.5);
        background-color: rgba(76, 175, 80, 0.05) !important;
    }

    /* 他の欄を入力している間、自動入力の欄は仮の値として半透明・斜体にする */
    .score-input-auto-filling input {
        opacity: 0.4 !important;
        transition: opacity 0.15s ease;
    }

    /* テンキーが開いている間は、テンキー分の余白を下に取って最後の行まで見えるようにする */
    .keypad-open-padding {
        padding-bottom: 320px !important;
    }

    /* ▽アイコンの分だけ左に余白を取り、名前を中央に見せる */
    .balanced-center-select input {
        text-align: center !important;
        padding-left: 10px !important;
    }

    /* ルール設定を閉じたとき、見出しの右側にルール名を出す */
    .rule-name-preview {
        margin-left: auto;
        margin-right: 8px;
        color: var(--mud-palette-text-secondary);
        font-size: 0.85rem;
        font-weight: normal;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        max-width: 55%;
        opacity: 0;
        /* パネルが閉じ終わる頃に、少し下からふわっと出す */
        animation: fadeInRuleName 0.4s ease-out 0.25s forwards;
    }

    @@keyframes fadeInRuleName {
        0% {
            opacity: 0;
            transform: translateY(4px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.Medium" Class="@($"mt-4 pb-10 {(activeScoreInputIndex.HasValue ? "keypad-open-padding" : "")}")" @onclick="OnContainerClick" Style="min-height: 100vh;">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6" Style="font-family: 'Kaisei Decol', serif; font-weight: bold; color: white; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
        <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Large" Class="mr-2" Style="vertical-align: bottom;" />
        素点集計
    </MudText>

    @* --- ルール設定（折りたたみ可） --- *@
    <MudExpansionPanels Class="mb-6">
        <MudExpansionPanel @bind-Expanded="isSettingsExpanded">
            <TitleContent>
                <div class="d-flex align-center w-100 pr-2">
                    <span style="font-weight:bold; white-space: nowrap;">ルール設定</span>
                    @if (!isSettingsExpanded && !string.IsNullOrWhiteSpace(rules.Name))
                    {
                        <span class="rule-name-preview">@rules.Name</span>
                    }
                </div>
            </TitleContent>
            <ChildContent>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mb-4" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenPresetDialog" Disabled="isEditing">
                    保存済みの設定を呼び出す
                </MudButton>
                <MudCard Outlined="true" Class="w-100">
                    <MudCardHeader Class="pb-0">
                        <CardHeaderContent>
                            <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenCustomRuleDialog" Disabled="isEditing">
                                        カスタム<span class="d-none d-sm-inline">ルール</span>
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SavePreset">
                                        <span class="d-none d-sm-inline">現在の</span>設定保存
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-2 pa-sm-3 pt-1 mt-2">
                        <MudGrid Spacing="2">
                            <MudItem xs="6" sm="8">
                                <MudTextField T="string" Label="ルール名" Value="rules.Name" ValueChanged="@((string v) => OnRuleNameChanged(v))" Margin="Margin.Dense" onfocus="this.select();" Class="px-2" @onfocusin="@(() => CloseKeypad())" />
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudSelect T="int" Label="対局人数" Value="rules.PlayerCount" ValueChanged="OnPlayerCountChanged" Disabled="isEditing" Margin="Margin.Dense" Class="px-2">
                                    <MudSelectItem Value="@(4)">四人麻雀</MudSelectItem>
                                    <MudSelectItem Value="@(3)">三人麻雀</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudNumericField T="int" Label="持ち点" Value="rules.StartingPoints" ValueChanged="OnStartingPointsChanged" Step="5000" Min="0" Margin="Margin.Dense" Class="px-2" @onfocusin="@(() => CloseKeypad())" />
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudNumericField T="int" Label="返し点" Value="rules.ReturnPoints" ValueChanged="OnReturnPointsChanged" Step="5000" Min="0" Margin="Margin.Dense" Class="px-2" @onfocusin="@(() => CloseKeypad())" />
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudNumericField Label="@($"レート ({Currency.Unit}/1k)")" T="int" Value="rules.Rate" ValueChanged="OnRateChanged" Step="10" Min="0" Margin="Margin.Dense" Class="px-2" @onfocusin="@(() => CloseKeypad())" />
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudNumericField Label="@($"チップ ({Currency.Unit}/枚)")" T="int" Value="rules.ChipRate" ValueChanged="OnChipRateChanged" Step="50" Min="0" Margin="Margin.Dense" Class="px-2" @onfocusin="@(() => CloseKeypad())" />
                            </MudItem>
                            @if (rules.IsCustomUma)
                            {
                                <MudItem xs="12" sm="8">
                                    <MudTextField Label="カスタム順位ウマ" Value="@rules.GetUmaDisplayText(true)" ReadOnly="true" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Close" OnAdornmentClick="DisableCustomUma" Style="font-variant-numeric: tabular-nums;" Class="px-2" />
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="6" sm="4">
                                    <MudNumericField T="int" Label="@(rules.PlayerCount == 3 ? "順位ウマ(1←2)" : "順位ウマ(2←3)")" Value="rules.Uma1" ValueChanged="@((int v) => OnUmaChanged(v, rules.Uma2))" Step="5" Min="0" Margin="Margin.Dense" Class="px-2" @onfocusin="@(() => CloseKeypad())" />
                                </MudItem>
                                <MudItem xs="6" sm="4">
                                    <MudNumericField T="int" Label="@(rules.PlayerCount == 3 ? "順位ウマ(1←3)" : "順位ウマ(1←4)")" Value="rules.Uma2" ValueChanged="@((int v) => OnUmaChanged(rules.Uma1, v))" Step="5" Min="0" Margin="Margin.Dense" Class="px-2" @onfocusin="@(() => CloseKeypad())" />
                                </MudItem>
                            }
                            <MudItem xs="12">
                                <MudTextField T="string" Label="その他のルール（メモ）" Value="rules.Memo" ValueChanged="OnMemoChanged" Placeholder="例: 北抜き / 取りきり / 赤3枚 / 鳴き祝儀なし / 流し満貫は満貫 / ツモ損あり" Lines="2" Sizing="InputSizing.Auto" MaxLines="8" MaxLength="500" Margin="Margin.Dense" Class="px-2" @onfocusin="@(() => CloseKeypad())" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

    @* --- 対局者と素点の入力 --- *@
    <MudPaper id="score-input-section" Class="pa-2 pa-sm-4 mb-6" Elevation="2">
        @if (isEditing)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" NoIcon="true" Class="mb-3">
                <div class="d-flex align-center justify-space-between gap-3">
                    <div>
                        <div style="font-weight: bold;">第@(EditingGameNumber)戦を修正中</div>
                        <div style="font-size: 0.75rem;">現在のルールで再計算されます</div>
                    </div>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Style="color: inherit; border-color: currentColor; flex-shrink: 0;" OnClick="@(() => CancelEditAsync())">キャンセル</MudButton>
                </div>
            </MudAlert>
        }
        <div class="mb-3 px-1">
            <MudText Style="font-weight: bold;" Class="mb-1">素点入力</MudText>
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%; overflow: hidden;">
                <div class="d-flex align-center">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddParticipant" Disabled="@(activeParticipantCount >= MaxParticipants || isEditing)" Style="min-width: 0; padding-left: 4px; padding-right: 4px;">
                        <span style="white-space: nowrap;">追加</span>
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonRemove" OnClick="RemoveParticipant" Disabled="@(activeParticipantCount <= rules.PlayerCount || isEditing)" Style="min-width: 0; padding-left: 4px; padding-right: 4px;">
                        <span style="white-space: nowrap;">削除</span>
                    </MudButton>
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.History" OnClick="CopyPreviousGame" Disabled="@(ActiveHistory.Count == 0 || isEditing)" Style="white-space: nowrap; flex-shrink: 0; padding-left: 4px; padding-right: 4px;">
                    前回の入力をコピー
                </MudButton>
            </MudStack>
        </div>
        <MudGrid Spacing="1" AlignItems="AlignItems.Center">
            @for (int i = 0; i < activeParticipantCount; i++)
            {
                var index = i;
                bool isSitOut = currentSitOuts[index];
                <MudItem xs="12" sm="6">
                    <MudPaper Outlined="true" Elevation="0" Class="d-flex align-center justify-space-between px-2 py-1" Style="@($"background-color: rgba(255,255,255,0.02); transition: opacity 0.3s; {(isSitOut ? "opacity: 0.4;" : "")}")">
                        @* 名前 *@
                        <MudAutocomplete T="string" Placeholder="@($"対局者 {index + 1}")" Value="currentPlayers[index].Name" ValueChanged="@((string v) => OnPlayerNameChanged(index, v))" SearchFunc="@SearchRegisteredPlayers" CoerceText="true" CoerceValue="true" MinCharacters="0" ShowOnFocus="true" DisableUnderLine="true" Margin="Margin.Dense" Class="player-name-input balanced-center-select" Style="font-weight: bold; font-size: 0.95rem; width: 9.5em;" Disabled="@(isSitOut || isEditing)" onfocus="this.select();" @onfocusin="@(() => CloseKeypad())" />
                        <div class="d-flex align-center justify-center flex-grow-1">
                            @* 抜け番 *@
                            @if (activeParticipantCount > rules.PlayerCount)
                            {
                                <MudToggleIconButton Toggled="currentSitOuts[index]" ToggledChanged="@((bool v) => OnSitOutChanged(index, v))" Icon="@Icons.Material.Filled.Person" Color="Color.Default" Title="参加中" ToggledIcon="@Icons.Material.Filled.LocalCafe" ToggledColor="Color.Default" ToggledTitle="☕ 抜け番" Size="Size.Small" ToggledSize="Size.Small" Class="mr-1" Disabled="isEditing" />
                            }
                            @* 焼き鳥 *@
                            @if (rules.IsYakiEnabled)
                            {
                                <MudToggleIconButton @bind-Toggled="currentYaki[index]" Icon="@Icons.Material.Filled.NoMeals" Color="Color.Default" Title="焼き鳥ではありません" ToggledIcon="@YakiIcon" ToggledColor="Color.Warning" ToggledTitle="🍗 焼き鳥です" Size="Size.Small" ToggledSize="Size.Small" Class="mr-1" Disabled="isSitOut" />
                            }
                            @* トビ賞 *@
                            @if (rules.IsTobiEnabled)
                            {
                                <MudToggleIconButton @bind-Toggled="currentTobiBonus[index]" Icon="@Icons.Material.Filled.Rocket" Color="Color.Default" Title="トビ賞を獲得しません" ToggledIcon="@Icons.Material.Filled.RocketLaunch" ToggledColor="Color.Error" ToggledTitle="🚀 トビ賞を獲得します" Size="Size.Small" ToggledSize="Size.Small" Class="mr-1" Disabled="isSitOut" />
                            }
                        </div>
                        @* 素点（百点単位で入力し、下2桁の「00」は表示だけ） *@
                        <div id="score-input-@index" class="d-flex align-baseline" @onclick="@(async () => await OpenKeypad(index))" @onclick:stopPropagation="true">
                            <MudTextField T="string" Value="@scoreInputBuffers[index]" ReadOnly="true" DisableUnderLine="true" Margin="Margin.Dense" Class="@($"score-input {(index == autoFilledIndex ? "auto-filled" : "")} {(activeScoreInputIndex == index ? "score-input-active" : "")} {(activeScoreInputIndex.HasValue && index == autoFilledIndex ? "score-input-auto-filling" : "")}")" Style="width: 77px; cursor: pointer;" Disabled="isSitOut" Adornment="@(index == autoFilledIndex ? Adornment.Start : Adornment.None)" AdornmentIcon="@Icons.Material.Filled.AutoAwesome" AdornmentColor="Color.Info" />
                            <span class="score-zeros" style="cursor: pointer;">00</span>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Class="mt-2 py-3" Disabled="@(!IsTotalCorrect)" OnClick="CalculateAndRecordGame">@(isEditing ? "修正を保存" : "結果を記録する")</MudButton>
    </MudPaper>

    @* --- 結果表 --- *@
    <MudPaper Class="pa-2 px-sm-4" Elevation="2">
        <ResultTable History="ActiveHistory" Players="TablePlayers" ActiveParticipantCount="TablePlayers.Count" @bind-DisplayMode="displayMode" Rules="rules" SessionChips="TablePlayers.Select(p => ActiveSessionChips.TryGetValue(p, out var v) ? v : 0).ToList()" IsReadOnly="false" ArmedDeleteTarget="armedDeleteTarget" OnDeleteRequested="HandleDeleteRequest" OnResetRequested="ConfirmReset" OnChipChanged="HandleChipChangedCallback" ActiveChipInputIndex="@activeChipInputIndex" ChipInputBuffer="@chipInputBuffer" OnChipInputClicked="OpenChipKeypad" OnRowClicked="StartEditGameAsync" EditingTarget="editingGame" IsEditing="isEditing" />
        <div class="d-flex justify-center mt-6">
            <div class="d-flex gap-2" style="width: 100%; max-width: 400px;">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Payments" Disabled="@(ActiveHistory.Count == 0 || isEditing)" OnClick="NavigateToSettlement" Style="flex: 4; font-weight: bold; padding: 4px 0; white-space: nowrap;">
                    場代精算
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.QueryStats" Disabled="@(ActiveHistory.Count == 0 || isEditing)" OnClick="ConfirmFinalizeSession" Style="flex: 6; font-weight: bold; padding: 4px 0; white-space: nowrap;">
                    成績に保存
                </MudButton>
            </div>
        </div>
        <ShareButtonGroup Rules="rules" TablePlayers="TablePlayers" ActiveHistory="ActiveHistory" ActiveSessionChips="ActiveSessionChips" />
    </MudPaper>
</MudContainer>

@* テンキーの外を触ったときに JS から押す隠しボタン（wwwroot/js/keypad.js） *@
<button id="hidden-close-keypad-btn" style="display: none;" @onclick="CloseKeypadOutside"></button>
<ScoreKeypad IsOpen="isKeypadOpen" IsTotalCorrect="IsTotalCorrect" ShowRecordButton="showRecordButton" RecordLabel="@(isEditing ? "保存" : "記録")" OnKeyPress="OnKeypadPress" />

@code {
    [CascadingParameter] public CurrencySetting Currency { get; set; } = new();
    // 入力欄の対局者
    public class PlayerInputState
    {
        public string? Id { get; set; } // 名簿にある人はそのID、新しい名前なら null
        public string Name { get; set; } = string.Empty;
    }
    private RuleSet rules => SessionState.Rules;
    private List<RuleSet> rulePresets = new();
    private const int MaxParticipants = 7;
    private int activeParticipantCount
    {
        get => SessionState.ActiveParticipantCount;
        set => _ = SessionState.SaveActiveParticipantCountAsync(value);
    }
    private List<PlayerInputState> currentPlayers = Enumerable.Range(0, 7).Select(_ => new PlayerInputState()).ToList();
    private List<PlayerProfile> playerMaster = new();
    private List<int?> currentScores => scoreInputBuffers.Select(val => EvaluateScoreExpression(val)).ToList();
    private bool isFinalizing = false;
    private List<int?> previousScores = Enumerable.Repeat((int?)null, MaxParticipants).ToList();
    private List<GameResult> ActiveHistory => SessionState.ActiveHistory;
    private Dictionary<string, int> ActiveSessionChips => SessionState.ActiveSessionChips;
    private int displayMode = 1;
    private bool isSettingsExpanded = true;
    private bool IsTotalCorrect
    {
        get
        {
            var activeScores = currentScores.Take(activeParticipantCount).Where((s, i) => !currentSitOuts[i]).ToList();
            if (activeScores.Count(x => x.HasValue) != rules.PlayerCount) return false;
            return activeScores.Sum(x => x ?? 0) == (rules.StartingPoints * rules.PlayerCount) / 100;
        }
    }
    private List<bool> currentYaki = new(new bool[MaxParticipants]);
    private List<bool> currentTobiBonus = new(new bool[MaxParticipants]);
    private List<bool> currentSitOuts = new(new bool[MaxParticipants]);
    private const string YakiIcon = "<g transform=\"matrix(0.025, 0, 0, 0.025, 0, 24)\"><path d=\"M843-60 670-234l-85 85q-23 23-56.5 23T472-149l-57-56q-23-23-23-56.5t23-56.5l-56-57q-23 23-56.5 23T246-375l-57-56q-23-23-23-56.5t23-56.5l-56-57q-23-23-23-56.5t23-56.5l28-28L60-844l56-56 102 102 28-28q23-23 57-23t57 23l56 56q23-23 56.5-23t56.5 23l57 56q23 23 23 57t-23 57l56 56q23-23 56.5-23t56.5 23l57 56q23 23 23 57t-23 57l-85 84 172 173-56 57ZM529-205l227-226-57-57-227 227 57 56Zm-57-170 114-113-57-56-113 113 56 56Zm-170-56 227-227-57-56-226 226 56 57Zm-56-170 114-113-57-57-113 113 56 57Zm368 255ZM501-460ZM388-573ZM275-686Z\"/></g>";
    private GameResult? armedDeleteTarget = null;
    private int? activeScoreInputIndex = null;
    private int? activeChipInputIndex = null;
    private string chipInputBuffer = "";
    private bool isKeypadOpen => activeScoreInputIndex.HasValue || activeChipInputIndex.HasValue;
    private bool showRecordButton => activeScoreInputIndex.HasValue;
    private string[] scoreInputBuffers
    {
        get => SessionState.ScoreInputBuffers;
        set => _ = SessionState.SaveScoreBuffersAsync(value);
    }

    protected override async Task OnInitializedAsync()
    {
        locationChangingRegistration = NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);
        await LiveShare.EnsureLoadedAsync();
        // 1. 入力中のセッションの状態
        await SessionState.InitializeStateAsync();
        // 2. 名簿（名前の候補とIDの対応に使う）
        try
        {
            var dbData = await DatabaseService.GetAllDataAsync();
            if (dbData?.Players != null) playerMaster = dbData.Players;
        }
        catch
        {
        }
        // 3. 入力欄の名前に、名簿のIDを対応づける
        for (int i = 0; i < 7; i++)
        {
            string savedName = SessionState.CurrentPlayerNames[i];
            currentPlayers[i].Name = savedName;
            if (!string.IsNullOrEmpty(savedName))
            {
                var matched = playerMaster.FirstOrDefault(p => p.Name == savedName);
                if (matched != null) currentPlayers[i].Id = matched.Id;
            }
        }
        // 4. ルールのプリセット（初回はよく使うものを用意する）
        List<RuleSet>? savedPresets;
        bool isPresetsUnreadable = false;
        try
        {
            savedPresets = await LocalStorage.GetItemAsync<List<RuleSet>>(StorageKeys.RulePresets);
        }
        catch (Exception ex)
        {
            // 読めない場合もデフォルトで起動を続ける（保存済みプリセットを上書きしないよう、保存はしない）
            Console.WriteLine($"プリセットの読み込みに失敗しました: {ex.Message}");
            savedPresets = null;
            isPresetsUnreadable = true;
        }
        if (savedPresets == null || savedPresets.Count == 0)
        {
            rulePresets = new List<RuleSet>
            {
                new RuleSet
                {
                    Name = "一般的な四麻",
                    PlayerCount = 4,
                    StartingPoints = 25000,
                    ReturnPoints = 30000,
                    Uma1 = 10,
                    Uma2 = 20
                },
                new RuleSet
                {
                    Name = "一般的な三麻",
                    PlayerCount = 3,
                    StartingPoints = 35000,
                    ReturnPoints = 40000,
                    Uma1 = 10,
                    Uma2 = 20
                },
                new RuleSet
                {
                    Name = "Mリーグルール",
                    PlayerCount = 4,
                    StartingPoints = 25000,
                    ReturnPoints = 30000,
                    Uma1 = 10,
                    Uma2 = 30,
                    Rate = 0,
                    ChipRate = 0,
                    TieBreaker = TieBreakerRule.Split
                }
            };
            if (!isPresetsUnreadable)
                await LocalStorage.SetItemAsync(StorageKeys.RulePresets, rulePresets);
        }
        else
        {
            rulePresets = savedPresets;
        }
        ResetInputForms(clearBuffers: false); // 復元した入力途中の素点は消さない
        EvaluateAutoFill();
    }

    // 持ち点を変えたら、オカ（返し点との差）を保ったまま返し点も動かす
    private async Task OnStartingPointsChanged(int val)
    {
        int currentOka = Math.Max(0, rules.ReturnPoints - rules.StartingPoints);
        rules.StartingPoints = val;
        rules.ReturnPoints = rules.StartingPoints + currentOka;
        EvaluateAutoFill();
