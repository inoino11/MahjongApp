    public void SyncNormalToCustomUma()
    {
        // 個別設定中は、手入力した値を上書きしない
        if (rules.IsCustomUma) return;
        if (rules.PlayerCount == 4)
        {
            rules.CustomUma4_1 = rules.Uma2;
            rules.CustomUma4_2 = rules.Uma1;
            rules.CustomUma4_3 = -rules.Uma1;
            rules.CustomUma4_4 = -rules.Uma2;
        }
        else if (rules.PlayerCount == 3)
        {
            // 三麻は2位・3位の両方から1位が受け取る
            rules.CustomUma3_1 = rules.Uma1 + rules.Uma2;
            rules.CustomUma3_2 = -rules.Uma1;
            rules.CustomUma3_3 = -rules.Uma2;
        }
    }

