    }

    // 結果表の行をタップしたら、その局を入力欄に読み込んで修正を始める
    private async Task StartEditGameAsync(GameResult game)
    {
        if (ReferenceEquals(game, editingGame)) return;
        int playedCount = game.RawScores.Count(s => s.HasValue);
        if (playedCount != rules.PlayerCount)
        {
            Snackbar.Add("現在の対局人数と異なる局のため修正できません", Severity.Warning);
            return;
        }
        if (isEditing) await CancelEditAsync();
        if (activeScoreInputIndex.HasValue || activeChipInputIndex.HasValue) await CloseKeypad();

        editStash = new EditStash
        {
            Players = currentPlayers.Select(p => (p.Name, p.Id)).ToList(),
            ParticipantCount = activeParticipantCount,
            Buffers = scoreInputBuffers.ToArray(),
            Yaki = currentYaki.ToList(),
            TobiBonus = currentTobiBonus.ToList(),
            SitOuts = currentSitOuts.ToList(),
            PreviousScores = previousScores.ToList(),
            AutoFilledIndex = autoFilledIndex
        };

        int slots = Math.Min(game.PlayerNames.Count, MaxParticipants);
        for (int i = 0; i < MaxParticipants; i++)
        {
            int? raw = i < slots && i < game.RawScores.Count ? game.RawScores[i] : null;
            string name = i < slots ? game.PlayerNames[i] : string.Empty;
            currentPlayers[i].Name = name;
            currentPlayers[i].Id = playerMaster.FirstOrDefault(p => p.Name == name)?.Id;
            // 配列ごと差し替えると保存されてしまうため要素を書き換える
            scoreInputBuffers[i] = raw?.ToString() ?? string.Empty;
            currentSitOuts[i] = i < slots && !raw.HasValue;
            currentYaki[i] = i < slots && (game.YakiPlayers?.ElementAtOrDefault(i) ?? false);
            currentTobiBonus[i] = i < slots && (game.TobiBonusRecipients?.ElementAtOrDefault(i) ?? false);
        }
        previousScores = Enumerable.Repeat((int?)null, MaxParticipants).ToList();
        autoFilledIndex = null;
        editingGame = game;
        if (activeParticipantCount != slots)
            await SessionState.SaveActiveParticipantCountAsync(slots);
        StateHasChanged();
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("scrollToInput", "score-input-section");
    }

    // 修正をやめて、修正前の途中入力を元に戻す（保存後・画面移動時もこれで戻す）
    private async Task CancelEditAsync()
    {
        if (editStash == null) return;
        var s = editStash;
        activeScoreInputIndex = null;
        for (int i = 0; i < MaxParticipants; i++)
        {
            currentPlayers[i].Name = s.Players[i].Name;
            currentPlayers[i].Id = s.Players[i].Id;
            scoreInputBuffers[i] = s.Buffers[i];
        }
        currentYaki = s.Yaki;
        currentTobiBonus = s.TobiBonus;
        currentSitOuts = s.SitOuts;
        previousScores = s.PreviousScores;
        autoFilledIndex = s.AutoFilledIndex;
        editingGame = null;
        editStash = null;
        if (activeParticipantCount != s.ParticipantCount)
            await SessionState.SaveActiveParticipantCountAsync(s.ParticipantCount);
        await SessionState.SaveScoreBuffersAsync(scoreInputBuffers);
        StateHasChanged();
    }

