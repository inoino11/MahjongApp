    // 計算に関わるルールだけを比べるため、メモを除いたJSONにする
    private static string RuleJsonWithoutMemo(RuleSet r)
    {
        var copy = r.DeepClone();
        copy.Memo = "";
        return System.Text.Json.JsonSerializer.Serialize(copy);
    }

    // セッションを確定して成績に保存する前の確認
    private async Task ConfirmFinalizeSession()
    {
        if (isFinalizing) return;
        isFinalizing = true;
        try
        {
            // ルール名が空、またはプリセットから内容を変えているなら、ルール名を「未設定」にして記録する
            string ruleName = rules.Name;
            bool isRuleNameEmpty = string.IsNullOrWhiteSpace(ruleName);
            bool isPresetMatch = false;
            bool isPresetNameExists = false;
            if (!isRuleNameEmpty)
            {
                var preset = rulePresets.FirstOrDefault(p => p.Name == ruleName);
                if (preset != null)
                {
                    isPresetNameExists = true;
                    isPresetMatch = RuleJsonWithoutMemo(preset) == RuleJsonWithoutMemo(rules);
                }
            }
            bool needsRuleNameChange = false;
            string msg = "対局結果とチップ枚数を通算成績に記録して<br />現在の入力フォームをリセットしますか？";
            if (isRuleNameEmpty)
            {
                needsRuleNameChange = true;
                msg = "<span style='color: var(--mud-palette-warning); font-weight: bold;'>ルール名が未入力です。</span><br /><br />ルール名を「<b>未設定</b>」として<br />" + msg;
            }
            else if (isPresetNameExists && !isPresetMatch)
            {
                needsRuleNameChange = true;
                msg = $"<span style='color: var(--mud-palette-warning); font-weight: bold;'>ルール名「{ruleName}」はプリセットから<br />内容が変更されています。</span><br /><br />ルール名を「<b>未設定</b>」として<br />" + msg;
            }
            int chipSum = ActiveSessionChips.Values.Sum();
            bool isChipError = chipSum != 0;
            if (isChipError)
            {
                msg += "<br /><br /><span style='color: #ff6b6b; font-weight: bold;'>※チップの合計枚数が " + (chipSum > 0 ? "+" : "") + chipSum + "枚です。</span>";
            }
            bool? result = await DialogService.ShowMessageBoxAsync(
                "対局セッションの終了確定",
                (MarkupString)msg,
                yesText: needsRuleNameChange ? "「未設定」で記録" : "記録してリセット",
                cancelText: "キャンセル"
            );

            if (result == true)
            {
                if (needsRuleNameChange)
                {
                    rules.Name = "未設定";
                    await SessionState.SaveRulesAsync(rules);
                }
                await FinalizeAndSaveToDbAsync();
            }
        }
        finally
        {
            isFinalizing = false;
        }
    }

    // セッションを確定して成績（IndexedDB）に保存し、入力中の記録を片付ける
    private async Task FinalizeAndSaveToDbAsync()
    {
        try
        {
            var sessionPlayerNames = ActiveHistory.SelectMany(h => h.PlayerNames.Select((name, idx) => new { Name = name, HasScore = idx < h.RawScores.Count && h.RawScores[idx].HasValue }).Where(x => x.HasScore && !string.IsNullOrWhiteSpace(x.Name)).Select(x => x.Name)).Distinct().ToList();
            var nameToIdMap = new Dictionary<string, string>();
            var playersToUpdate = new List<PlayerProfile>();
            var gameRecordsToSave = new List<SavedGameRecord>();
            var newSessionId = Guid.NewGuid().ToString();
            var currentTimestamp = DateTime.Now;
            foreach (var name in sessionPlayerNames)
            {
                var existingPlayer = playerMaster.FirstOrDefault(p => p.Name == name);
                if (existingPlayer != null)
                {
                    nameToIdMap[name] = existingPlayer.Id; playersToUpdate.Add(new PlayerProfile { Id = existingPlayer.Id, Name = existingPlayer.Name, CumulativeChips = existingPlayer.CumulativeChips, CreatedAt = existingPlayer.CreatedAt });
                }
                else
                {
                    var newId = Guid.NewGuid().ToString();
                    var newProfile = new PlayerProfile { Id = newId, Name = name, CumulativeChips = 0, CreatedAt = currentTimestamp }; playerMaster.Add(newProfile);
                    playersToUpdate.Add(newProfile); nameToIdMap[name] = newId;
                }
            }
            foreach (var game in ActiveHistory)
            {
                var savedRecord = new SavedGameRecord
                {
                    Id = Guid.NewGuid().ToString(),
                    SessionId = newSessionId,
                    RuleName = rules.Name,
                    PlayerCount = rules.PlayerCount,
                    Timestamp = game.Timestamp,
                    PlayerIds = game.PlayerNames.Select(name => !string.IsNullOrWhiteSpace(name) && nameToIdMap.ContainsKey(name) ? nameToIdMap[name] : null).ToList(),
                    RawScores = game.RawScores,
                    Points = game.Points,
                    Yen = game.Yen,
                    SinkPoints = game.SinkPoints != null ? new List<double>(game.SinkPoints) : new(),
                    YakiPoints = game.YakiPoints != null ? new List<double>(game.YakiPoints) : new(),
                    TobiPoints = game.TobiPoints != null ? new List<double>(game.TobiPoints) : new(),
                    ColdPoints = game.ColdPoints != null ? new List<double>(game.ColdPoints) : new()
                };
                gameRecordsToSave.Add(savedRecord);
            }
            var sessionRecord = new SavedSessionRecord
            {
                SessionId = newSessionId,
                Date = currentTimestamp,
                Rate = rules.Rate,
                ChipRate = rules.ChipRate,
                ParticipantPlayerIds = new List<string>(),
                SettledChips = new List<int>(),
                Rules = rules.DeepClone()
            };

            for (int i = 0; i < TablePlayers.Count; i++)
            {
                string name = TablePlayers[i];
                if (!string.IsNullOrWhiteSpace(name) && nameToIdMap.TryGetValue(name, out var playerId))
                {
                    int chipCount = ActiveSessionChips.TryGetValue(name, out var c) ? c : 0;
                    sessionRecord.ParticipantPlayerIds.Add(playerId);
                    sessionRecord.SettledChips.Add(chipCount);
                }
            }
            await DatabaseService.SaveSessionAsync(playersToUpdate, sessionRecord, gameRecordsToSave);
            if (LiveShare.IsActive) await LiveShare.EndAsync("finished", BuildSharePayloadJson());
            ActiveHistory.Clear();
            ActiveSessionChips.Clear();
            await LocalStorage.SetItemAsync(StorageKeys.ActiveHistory, ActiveHistory);
            await LocalStorage.SetItemAsync(StorageKeys.ActiveSessionChips, ActiveSessionChips);
            ResetInputForms();
            Snackbar.Add("対局結果を通算成績に保存しました！", Severity.Success);
            _ = StatsCache.InitializeAsync(forceReload: true);
            StateHasChanged();
        }
        catch (Exception ex) { Snackbar.Add("保存中にエラーが発生しました:\n" + ex.Message, Severity.Error); }
    }

    // --- テンキー ---
    // 素点の入力でテンキーを開く
    private async Task OpenKeypad(int index)
    {
        if (currentSitOuts[index]) return;
        if (activeChipInputIndex.HasValue) await CloseKeypad();
        bool isAlreadyOpen = activeScoreInputIndex.HasValue;
        if (activeScoreInputIndex.HasValue && activeScoreInputIndex.Value != index)
            await CommitScoreBuffer(activeScoreInputIndex.Value);
        activeScoreInputIndex = index;
        var score = currentScores[index];
        if (string.IsNullOrEmpty(scoreInputBuffers[index]) && score.HasValue)
            scoreInputBuffers[index] = score.Value.ToString();
        if (!isAlreadyOpen)
        {
            await Task.Delay(50);
            await JSRuntime.InvokeVoidAsync("scrollToInput", "score-input-section");
        }
    }

    // チップの入力でテンキーを開く
    private async Task OpenChipKeypad(int index)
    {
        if (activeScoreInputIndex.HasValue) await CloseKeypad();
        activeChipInputIndex = index;
        var name = TablePlayers[index];
        int currentChip = ActiveSessionChips.TryGetValue(name, out var c) ? c : 0;
        chipInputBuffer = currentChip == 0 ? "" : currentChip.ToString();
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("scrollToInput", "table-wrapper");
    }

    private async Task CloseKeypad(bool saveToStorage = true)
    {
        if (activeScoreInputIndex.HasValue)
            await CommitScoreBuffer(activeScoreInputIndex.Value, saveToStorage);
        if (activeChipInputIndex.HasValue)
        {
            int? finalChip = EvaluateScoreExpression(chipInputBuffer);
            var name = TablePlayers[activeChipInputIndex.Value];
            ActiveSessionChips[name] = finalChip ?? 0;
            if (saveToStorage)
                await LocalStorage.SetItemAsync(StorageKeys.ActiveSessionChips, ActiveSessionChips);
            chipInputBuffer = "";
        }
        activeScoreInputIndex = null;
        activeChipInputIndex = null;
        StateHasChanged();
    }

