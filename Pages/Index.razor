@page "/"
@using MahjongApp.Services
@implements IDisposable
@inject ILocalStorageService LocalStorage
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject MahjongApp.Services.DatabaseService DatabaseService
@inject MahjongApp.Services.StatsCacheService StatsCache
@inject MahjongApp.Services.SessionStateService SessionState
@inject MahjongApp.Services.MahjongCalculatorService Calculator
@inject MahjongApp.Services.LiveShareService LiveShare
@inject MahjongApp.Services.CloudBackupService CloudBackup
@inject MahjongApp.Services.RulePresetService PresetService

<style>
    .player-name-input input {
        text-align: center !important;
        letter-spacing: 1px;
    }

    /* 入力中でない名前欄は控えめに表示する */
    .player-name-input:not(:focus-within) {
        opacity: 0.85;
    }

    .score-input input {
        text-align: right !important;
        font-size: 1.3rem !important;
        font-weight: 500 !important;
        padding-right: 2px !important;
    }

    .score-input.auto-filled input {
        color: var(--mud-palette-info) !important;
    }

    .score-input.mud-input-control .mud-input-outlined {
        height: 28px !important;
        min-height: 28px !important;
    }

    .score-input.mud-input-control .mud-input-outlined .mud-input-adornment-start {
        margin: 0 !important;
    }

    .score-input.mud-input-control .mud-input-outlined .mud-input-adornment-start svg {
        font-size: 16px !important;
    }

    .score-zeros {
        font-size: 1.3rem;
        font-weight: 500;
        color: #808080;
        margin-left: 2px;
        user-select: none;
    }

    /* 自動入力のアイコンが付いても、文字の高さがずれないようにする */
    .score-input .mud-input {
        align-items: baseline !important;
    }

    /* アイコン自体は高さの中央を維持する */
    .score-input .mud-input-adornment-start {
        align-self: center !important;
        margin-top: 0 !important;
    }

    /* テンキーで入力中の素点欄 */
    .score-input-active {
        border: 1px solid #81c784 !important;
        box-shadow: 0 0 6px rgba(129, 199, 132, 0.5);
        background-color: rgba(76, 175, 80, 0.05) !important;
    }

    /* 他の欄を入力している間、自動入力の欄は仮の値として半透明・斜体にする */
    .score-input-auto-filling input {
        opacity: 0.4 !important;
        transition: opacity 0.15s ease;
    }

    /* テンキーが開いている間は、テンキー分の余白を下に取って最後の行まで見えるようにする */
    .keypad-open-padding {
        padding-bottom: 320px !important;
    }

    /* ▽アイコンの分だけ左に余白を取り、名前を中央に見せる */
    .balanced-center-select input {
        text-align: center !important;
        padding-left: 10px !important;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Medium" Class="@($"mt-4 pb-10 {(activeScoreInputIndex.HasValue ? "keypad-open-padding" : "")}")" @onclick="OnContainerClick" Style="min-height: 100vh;">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6" Style="font-family: 'Kaisei Decol', serif; font-weight: bold; color: white; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
        <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Large" Class="mr-2" Style="vertical-align: bottom;" />
        素点集計
    </MudText>

    @* --- ルール設定 --- *@
    <RuleSettingsPanel IsEditing="isEditing" OnRulesChanged="HandleRulesChanged" OnFieldFocus="@(() => CloseKeypad())" />

    @* --- 対局者と素点の入力 --- *@
    <MudPaper id="score-input-section" Class="pa-2 pa-sm-4 mb-6" Elevation="2">
        @if (isEditing)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" NoIcon="true" Class="mb-3">
                <div class="d-flex align-center justify-space-between gap-3">
                    <div>
                        <div style="font-weight: bold;">第@(EditingGameNumber)戦を修正中</div>
                        <div style="font-size: 0.75rem;">現在のルールで再計算されます</div>
                    </div>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Style="color: inherit; border-color: currentColor; flex-shrink: 0;" OnClick="@(() => CancelEditAsync())">キャンセル</MudButton>
                </div>
            </MudAlert>
        }
        <div class="mb-3 px-1">
            <MudText Style="font-weight: bold;" Class="mb-1">素点入力</MudText>
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%; overflow: hidden;">
                <div class="d-flex align-center">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddParticipant" Disabled="@(activeParticipantCount >= MaxParticipants || isEditing)" Style="min-width: 0; padding-left: 4px; padding-right: 4px;">
                        <span style="white-space: nowrap;">追加</span>
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonRemove" OnClick="RemoveParticipant" Disabled="@(activeParticipantCount <= rules.PlayerCount || isEditing)" Style="min-width: 0; padding-left: 4px; padding-right: 4px;">
                        <span style="white-space: nowrap;">削除</span>
                    </MudButton>
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.History" OnClick="CopyPreviousGame" Disabled="@(ActiveHistory.Count == 0 || isEditing)" Style="white-space: nowrap; flex-shrink: 0; padding-left: 4px; padding-right: 4px;">
                    前回の入力をコピー
                </MudButton>
            </MudStack>
        </div>
        <MudGrid Spacing="1" AlignItems="AlignItems.Center">
            @for (int i = 0; i < activeParticipantCount; i++)
            {
                var index = i;
                bool isSitOut = input.SitOuts[index];
                <MudItem xs="12" sm="6">
                    <MudPaper Outlined="true" Elevation="0" Class="d-flex align-center justify-space-between px-2 py-1" Style="@($"background-color: rgba(255,255,255,0.02); transition: opacity 0.3s; {(isSitOut ? "opacity: 0.4;" : "")}")">
                        @* 名前 *@
                        <MudAutocomplete T="string" Placeholder="@($"対局者 {index + 1}")" Value="input.Players[index].Name" ValueChanged="@((string v) => OnPlayerNameChanged(index, v))" SearchFunc="@SearchRegisteredPlayers" CoerceText="true" CoerceValue="true" MinCharacters="0" ShowOnFocus="true" DisableUnderLine="true" Margin="Margin.Dense" Class="player-name-input balanced-center-select" Style="font-weight: bold; font-size: 0.95rem; width: 9.5em;" Disabled="@(isSitOut || isEditing)" onfocus="this.select();" @onfocusin="@(() => CloseKeypad())" />
                        <div class="d-flex align-center justify-center flex-grow-1">
                            @* 抜け番 *@
                            @if (activeParticipantCount > rules.PlayerCount)
                            {
                                <MudToggleIconButton Toggled="input.SitOuts[index]" ToggledChanged="@((bool v) => OnSitOutChanged(index, v))" Icon="@Icons.Material.Filled.Person" Color="Color.Default" Title="参加中" ToggledIcon="@Icons.Material.Filled.LocalCafe" ToggledColor="Color.Default" ToggledTitle="☕ 抜け番" Size="Size.Small" ToggledSize="Size.Small" Class="mr-1" Disabled="isEditing" />
                            }
                            @* 焼き鳥 *@
                            @if (rules.IsYakiEnabled)
                            {
                                <MudToggleIconButton @bind-Toggled="input.Yaki[index]" Icon="@Icons.Material.Filled.NoMeals" Color="Color.Default" Title="焼き鳥ではありません" ToggledIcon="@YakiIcon" ToggledColor="Color.Warning" ToggledTitle="🍗 焼き鳥です" Size="Size.Small" ToggledSize="Size.Small" Class="mr-1" Disabled="isSitOut" />
                            }
                            @* トビ賞 *@
                            @if (rules.IsTobiEnabled)
                            {
                                <MudToggleIconButton @bind-Toggled="input.TobiBonus[index]" Icon="@Icons.Material.Filled.Rocket" Color="Color.Default" Title="トビ賞を獲得しません" ToggledIcon="@Icons.Material.Filled.RocketLaunch" ToggledColor="Color.Error" ToggledTitle="🚀 トビ賞を獲得します" Size="Size.Small" ToggledSize="Size.Small" Class="mr-1" Disabled="isSitOut" />
                            }
                        </div>
                        @* 素点（百点単位で入力し、下2桁の「00」は表示だけ） *@
                        <div id="score-input-@index" class="d-flex align-baseline" @onclick="@(async () => await OpenKeypad(index))" @onclick:stopPropagation="true">
                            <MudTextField T="string" Value="@scoreInputBuffers[index]" ReadOnly="true" DisableUnderLine="true" Margin="Margin.Dense" Class="@($"score-input {(index == input.AutoFilledIndex ? "auto-filled" : "")} {(activeScoreInputIndex == index ? "score-input-active" : "")} {(activeScoreInputIndex.HasValue && index == input.AutoFilledIndex ? "score-input-auto-filling" : "")}")" Style="width: 77px; cursor: pointer;" Disabled="isSitOut" Adornment="@(index == input.AutoFilledIndex ? Adornment.Start : Adornment.None)" AdornmentIcon="@Icons.Material.Filled.AutoAwesome" AdornmentColor="Color.Info" />
                            <span class="score-zeros" style="cursor: pointer;">00</span>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Class="mt-2 py-3" Disabled="@(!IsTotalCorrect)" OnClick="CalculateAndRecordGame">@(isEditing ? "修正を保存" : "結果を記録する")</MudButton>
    </MudPaper>

    @* --- 結果表 --- *@
    <MudPaper Class="pa-2 px-sm-4" Elevation="2">
        <ResultTable History="ActiveHistory" Players="TablePlayers" ActiveParticipantCount="TablePlayers.Count" @bind-DisplayMode="displayMode" Rules="rules" SessionChips="TablePlayers.Select(p => ActiveSessionChips.TryGetValue(p, out var v) ? v : 0).ToList()" IsReadOnly="false" ArmedDeleteTarget="armedDeleteTarget" OnDeleteRequested="HandleDeleteRequest" OnResetRequested="ConfirmReset" OnChipChanged="HandleChipChangedCallback" ActiveChipInputIndex="@activeChipInputIndex" ChipInputBuffer="@chipInputBuffer" OnChipInputClicked="OpenChipKeypad" OnRowClicked="StartEditGameAsync" EditingTarget="editingGame" IsEditing="isEditing" />
        <div class="d-flex justify-center mt-6">
            <div class="d-flex gap-2" style="width: 100%; max-width: 400px;">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Payments" Disabled="@(ActiveHistory.Count == 0 || isEditing)" OnClick="NavigateToSettlement" Style="flex: 4; font-weight: bold; padding: 4px 0; white-space: nowrap;">
                    場代精算
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.QueryStats" Disabled="@(ActiveHistory.Count == 0 || isEditing)" OnClick="ConfirmFinalizeSession" Style="flex: 6; font-weight: bold; padding: 4px 0; white-space: nowrap;">
                    成績に保存
                </MudButton>
            </div>
        </div>
        <ShareButtonGroup Rules="rules" TablePlayers="TablePlayers" ActiveHistory="ActiveHistory" ActiveSessionChips="ActiveSessionChips" />
    </MudPaper>
</MudContainer>

@* テンキーの外を触ったときに JS から押す隠しボタン（wwwroot/js/keypad.js） *@
<button id="hidden-close-keypad-btn" style="display: none;" @onclick="CloseKeypadOutside"></button>
<ScoreKeypad IsOpen="isKeypadOpen" IsTotalCorrect="IsTotalCorrect" ShowRecordButton="showRecordButton" RecordLabel="@(isEditing ? "保存" : "記録")" OnKeyPress="OnKeypadPress" />

@code {
    [CascadingParameter] public CurrencySetting Currency { get; set; } = new();
    private RuleSet rules => SessionState.Rules;
    private const int MaxParticipants = ScoreInputState.MaxParticipants;
    private int activeParticipantCount
    {
        get => SessionState.ActiveParticipantCount;
        set => _ = SessionState.SaveActiveParticipantCountAsync(value);
    }
    // 素点入力欄の状態（素点の文字列は SessionState の配列を共有する）
    private ScoreInputState? _input;
    private ScoreInputState input => _input ??= new ScoreInputState(() => SessionState.ScoreInputBuffers);
    private List<PlayerProfile> playerMaster = new();
    private bool isFinalizing = false;
    private List<GameResult> ActiveHistory => SessionState.ActiveHistory;
    private Dictionary<string, int> ActiveSessionChips => SessionState.ActiveSessionChips;
    private int displayMode = 1;
    private bool IsTotalCorrect => input.IsTotalCorrect(rules, activeParticipantCount);
    private const string YakiIcon = "<g transform=\"matrix(0.025, 0, 0, 0.025, 0, 24)\"><path d=\"M843-60 670-234l-85 85q-23 23-56.5 23T472-149l-57-56q-23-23-23-56.5t23-56.5l-56-57q-23 23-56.5 23T246-375l-57-56q-23-23-23-56.5t23-56.5l-56-57q-23-23-23-56.5t23-56.5l28-28L60-844l56-56 102 102 28-28q23-23 57-23t57 23l56 56q23-23 56.5-23t56.5 23l57 56q23 23 23 57t-23 57l56 56q23-23 56.5-23t56.5 23l57 56q23 23 23 57t-23 57l-85 84 172 173-56 57ZM529-205l227-226-57-57-227 227 57 56Zm-57-170 114-113-57-56-113 113 56 56Zm-170-56 227-227-57-56-226 226 56 57Zm-56-170 114-113-57-57-113 113 56 57Zm368 255ZM501-460ZM388-573ZM275-686Z\"/></g>";
    private GameResult? armedDeleteTarget = null;
    private int? activeScoreInputIndex = null;
    private int? activeChipInputIndex = null;
    private string chipInputBuffer = "";
    private bool isKeypadOpen => activeScoreInputIndex.HasValue || activeChipInputIndex.HasValue;
    private bool showRecordButton => activeScoreInputIndex.HasValue;
    private string[] scoreInputBuffers
    {
        get => SessionState.ScoreInputBuffers;
        set => _ = SessionState.SaveScoreBuffersAsync(value);
    }

    protected override async Task OnInitializedAsync()
    {
        locationChangingRegistration = NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);
        await LiveShare.EnsureLoadedAsync();
        // 1. 入力中のセッションの状態
        await SessionState.InitializeStateAsync();
        // 2. 名簿（名前の候補とIDの対応に使う）
        try
        {
            var dbData = await DatabaseService.GetAllDataAsync();
            if (dbData?.Players != null) playerMaster = dbData.Players;
        }
        catch
        {
        }
        // 3. 入力欄の名前に、名簿のIDを対応づける
        for (int i = 0; i < 7; i++)
        {
            string savedName = SessionState.CurrentPlayerNames[i];
            input.Players[i].Name = savedName;
            if (!string.IsNullOrEmpty(savedName))
            {
                var matched = playerMaster.FirstOrDefault(p => p.Name == savedName);
                if (matched != null) input.Players[i].Id = matched.Id;
            }
        }
        ResetInputForms(clearBuffers: false); // 復元した入力途中の素点は消さない
        EvaluateAutoFill();
    }

    // ルール設定で変更があったとき。対局人数が変わったら入力欄をリセットする
    private async Task HandleRulesChanged(bool isPlayerCountChanged)
    {
        if (isPlayerCountChanged)
        {
            await SessionState.SaveActiveParticipantCountAsync(rules.PlayerCount);
            ResetInputForms();
            await SessionState.ClearScoreBuffersAsync();
        }
        ValidateDisplayMode();
        EvaluateAutoFill();
    }

    // 名前の入力候補（名簿から部分一致で探す）
    private Task<IEnumerable<string>> SearchRegisteredPlayers(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<string>>(playerMaster.Select(p => p.Name));
        var result = playerMaster
            .Where(p => p.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(p => p.Name);
        return Task.FromResult(result);
    }

    // 名前を変えたら、名簿にある人ならIDを対応づける（「削除済み」は予約名なので使えない）
    private async Task OnPlayerNameChanged(int index, string value)
    {
        if (value == "削除済み")
        {
            Snackbar.Add("名前「削除済み」は使用できません", Severity.Warning);
            input.Players[index].Name = string.Empty;
            input.Players[index].Id = null;
            await SessionState.UpdatePlayerNameAsync(index, string.Empty);
            return;
        }
        input.Players[index].Name = value;
        var matchedPlayer = playerMaster.FirstOrDefault(p => p.Name == value);
        input.Players[index].Id = matchedPlayer?.Id;
        await SessionState.UpdatePlayerNameAsync(index, value);
    }

    private async Task OnChipChanged(int index, int value)
    {
        if (index >= 0 && index < TablePlayers.Count)
        {
            var name = TablePlayers[index];
            if (!string.IsNullOrWhiteSpace(name)) await SessionState.UpdateChipValueAsync(name, value);
        }
    }

    // 局の結果を記録する（保存が終わる前の連打で二重に記録しないようにする）
    private bool isRecording = false;
    private async Task CalculateAndRecordGame()
    {
        if (isRecording) return;
        isRecording = true;
        try
        {
            await RecordGameAsync();
        }
        finally
        {
            isRecording = false;
        }
    }

    private async Task RecordGameAsync()
    {
        var active = input.BuildActiveInput(rules, activeParticipantCount);
        if (active == null) return;
        var activeScores = active.Scores;
        var activePlayers = active.Names;
        var activeYaki = active.Yaki;
        var activeTobiBonus = active.TobiBonus;
        // 1. 入力のチェック
        if (activePlayers.Any(string.IsNullOrWhiteSpace))
        {
            Snackbar.Add("対局者の名前を入力してください", Severity.Error);
            return;
        }
        if (activePlayers.Distinct().Count() != activePlayers.Count)
        {
            Snackbar.Add("対局者の中に同じ名前があります", Severity.Error);
            return;
        }
        if (activePlayers.Any(name => name == "削除済み"))
        {
            Snackbar.Add("名前「削除済み」は使用できません", Severity.Error);
            return;
        }
        if (rules.IsTobiEnabled)
        {
            bool hasTobi = activeScores.Any(s => rules.TobiJustIsTobi ? s <= rules.TobiPoint : s < rules.TobiPoint);
            bool hasTobiBonus = activeTobiBonus.Any(b => b);
            if (hasTobi != hasTobiBonus)
            {
                string msg = hasTobi
                    ? "トビが発生していますが\nボーナス獲得者（🚀）が選択されていません"
                    : "トビが発生していないのに\nボーナス獲得者（🚀）が選択されています";
                Snackbar.Add(msg, Severity.Error);
                return;
            }
        }
        // 2. 同点で席順が結果に影響するなら、席順を入力してもらう
        bool needsTieBreaker = Calculator.CheckIfTieBreakerNeeded(rules, activeScores, activeYaki, activeTobiBonus);
        Dictionary<int, int>? priority = needsTieBreaker
            ? await OpenTieBreakerIfNeeded(activeScores, activePlayers)
            : Enumerable.Range(0, rules.PlayerCount).ToDictionary(i => i, i => i);
        if (priority == null) return; // 席順の入力がキャンセルされた
        // 3. 計算
        var calcResult = Calculator.Calculate(rules, activeScores, activeYaki, activeTobiBonus, priority);
        // 4. 参加者だけで計算した結果を、抜け番を含む入力欄の並びに戻す
        var newGameResult = input.ToGameResult(active, calcResult, activeParticipantCount);
        // 5. 保存（修正中なら、その局を置き換える）
        if (editingGame != null)
        {
            int editIndex = ActiveHistory.IndexOf(editingGame);
            newGameResult.Timestamp = editingGame.Timestamp; // 修正しても局の時刻と位置は変えない
            await SessionState.ReplaceGameResultAsync(editIndex, newGameResult);
            await CancelEditAsync();
            Snackbar.Add($"第{editIndex + 1}戦を修正しました", Severity.Success);
            return;
        }
        await SessionState.AddGameResultAsync(newGameResult);
        ResetInputForms();
        await SessionState.ClearScoreBuffersAsync();
    }

    // 入力中の記録をすべて消す（確定済みの成績は消えない）
    private async Task ConfirmReset()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "入力中の記録のクリア",
            (MarkupString)$"現在入力中の対局記録とチップを破棄しますか？<br /><span style='font-size: 0.85rem; color: var(--mud-palette-text-secondary);'>※通算成績などの保存済みデータは消えません。</span>",
            yesText: "破棄する", cancelText: "キャンセル");
        if (result == true)
        {
            await SessionState.ClearSessionAsync();
            await LiveShare.EndAsync("discarded", null);
            Snackbar.Add("入力中の記録をクリアしました", Severity.Info);
            StateHasChanged();
        }
    }

    // 局の削除は2回押しで確定する（1回目は警告表示）
    private async Task HandleDeleteRequest(GameResult item)
    {
        if (armedDeleteTarget == item)
        {
            await SessionState.RemoveGameResultAsync(item);
            armedDeleteTarget = null;
        }
        else
        {
            armedDeleteTarget = item;
        }
    }

    private void CancelDelete()
    {
        if (armedDeleteTarget != null)
        {
            armedDeleteTarget = null;
            StateHasChanged();
        }
    }

    // 直前の局の素点・焼き鳥・トビ賞を入力欄に写す
    private async Task CopyPreviousGame()
    {
        if (ActiveHistory.Count == 0) return;
        var lastGame = ActiveHistory.Last();
        int requiredCount = lastGame.RawScores.Count;
        if (activeParticipantCount < requiredCount && activeParticipantCount < MaxParticipants)
            await SessionState.SaveActiveParticipantCountAsync(Math.Min(requiredCount, MaxParticipants));
        input.CopyFrom(lastGame, activeParticipantCount);
        EvaluateAutoFill();
        StateHasChanged();
        await SessionState.SaveScoreBuffersAsync(scoreInputBuffers);
    }

    // 結果表の列（対局者）
    private List<string> TablePlayers
    {
        get
        {
            // まだ1局もなければ、入力欄の名前（空欄を含む）を仮の列にする
            if (ActiveHistory.Count == 0)
                return input.Players.Take(activeParticipantCount).Select(p => p.Name).ToList();
            // 局があれば、素点が記録された名前を出てきた順に並べる
            return SessionRecordBuilder.CollectPlayerNames(ActiveHistory);
        }
    }

    // 入力欄をリセットする（clearBuffers が false なら素点の入力は残す）
    private void ResetInputForms(bool clearBuffers = true)
    {
        input.Reset();
        if (clearBuffers)
            scoreInputBuffers = Enumerable.Repeat(string.Empty, MaxParticipants).ToArray();
    }

    // 特殊ルールをオフにしたら、その内訳の表示からポイント表示に戻す
    private void ValidateDisplayMode()
    {
        displayMode = displayMode switch
        {
            3 when !rules.IsSinkEnabled => 1,
            4 when !rules.IsYakiEnabled => 1,
            5 when !rules.IsTobiEnabled => 1,
            6 when !rules.IsColdEnabled => 1,
            _ => displayMode
        };
    }

    // 席順を入力してもらう。戻り値は各参加者の同点時の順位（キャンセルなら null）
    private async Task<Dictionary<int, int>?> OpenTieBreakerIfNeeded(List<int> scores, List<string> players)
    {
        var priority = new Dictionary<int, int>();
        if (scores.Distinct().Count() == scores.Count)
        {
            for (int i = 0; i < scores.Count; i++) priority[i] = i;
            return priority;
        }
        var parameters = new DialogParameters { ["Players"] = players };
        var dialog = await DialogService.ShowAsync<TieBreakerDialog>("順位の決定", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<int> orderedIndices) return null;
        for (int i = 0; i < scores.Count; i++) priority[i] = orderedIndices.IndexOf(i);
        return priority;
    }

    private async Task HandleChipChangedCallback((int Index, int Value) args)
    {
        if (args.Index >= 0 && args.Index < TablePlayers.Count)
        {
            var name = TablePlayers[args.Index];
            if (!string.IsNullOrWhiteSpace(name))
            {
                ActiveSessionChips[name] = args.Value;
                await LocalStorage.SetItemAsync(StorageKeys.ActiveSessionChips, ActiveSessionChips);
            }
        }
    }

    // 参加者の枠を増やす（5人以上で抜け番を使えるようになる）
    private async Task AddParticipant()
    {
        if (activeParticipantCount < MaxParticipants)
        {
            int newIndex = activeParticipantCount;
            if (input.AutoFilledIndex.HasValue) input.SitOuts[newIndex] = true;
            await SessionState.SaveActiveParticipantCountAsync(activeParticipantCount + 1);
            EvaluateAutoFill();
        }
    }

    // 参加者の枠を減らす。最後の枠を消し、抜け番が不要になれば全員を参加に戻す
    private async Task RemoveParticipant()
    {
        if (activeParticipantCount > rules.PlayerCount)
        {
            input.ClearLastSlot(rules, activeParticipantCount);
            await SessionState.SaveScoreBuffersAsync(scoreInputBuffers);
            await SessionState.SaveActiveParticipantCountAsync(activeParticipantCount - 1);
            EvaluateAutoFill();
        }
    }

    // 抜け番にしたら素点を退避し、参加に戻したら元に戻す
    private void OnSitOutChanged(int index, bool isSitOut)
    {
        input.SetSitOut(index, isSitOut);
        EvaluateAutoFill();
    }

    // --- 記録済みの局の修正 ---
    private GameResult? editingGame = null;
    private bool isEditing => editingGame != null;
    private ScoreInputState.Snapshot? editStash = null; // 修正前に入力欄にあった途中の入力
    private IDisposable? locationChangingRegistration;
    private int EditingGameNumber => editingGame == null ? 0 : ActiveHistory.IndexOf(editingGame) + 1;

    // 結果表の行をタップしたら、その局を入力欄に読み込んで修正を始める
    private async Task StartEditGameAsync(GameResult game)
    {
        if (ReferenceEquals(game, editingGame)) return;
        int playedCount = game.RawScores.Count(s => s.HasValue);
        if (playedCount != rules.PlayerCount)
        {
            Snackbar.Add("現在の対局人数と異なる局のため修正できません", Severity.Warning);
            return;
        }
        if (isEditing) await CancelEditAsync();
        if (activeScoreInputIndex.HasValue || activeChipInputIndex.HasValue) await CloseKeypad();

        editStash = input.TakeSnapshot(activeParticipantCount);
        int slots = input.LoadGame(game, playerMaster);
        editingGame = game;
        if (activeParticipantCount != slots)
            await SessionState.SaveActiveParticipantCountAsync(slots);
        StateHasChanged();
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("scrollToInput", "score-input-section");
    }

    // 修正をやめて、修正前の途中入力を元に戻す（保存後・画面移動時もこれで戻す）
    private async Task CancelEditAsync()
    {
        if (editStash == null) return;
        var s = editStash;
        activeScoreInputIndex = null;
        input.Restore(s);
        editingGame = null;
        editStash = null;
        if (activeParticipantCount != s.ParticipantCount)
            await SessionState.SaveActiveParticipantCountAsync(s.ParticipantCount);
        await SessionState.SaveScoreBuffersAsync(scoreInputBuffers);
        StateHasChanged();
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (isEditing) await CancelEditAsync();
    }

    public void Dispose() => locationChangingRegistration?.Dispose();

    // --- 観戦URL ---
    private string BuildSharePayloadJson() => SharePayloadBuilder.BuildJson(rules, TablePlayers, ActiveHistory, ActiveSessionChips, Currency);

    // 記録・削除・修正・チップ・ルール変更はいずれも再描画を伴うため、描画後に内容の変化を検知して送る
    protected override void OnAfterRender(bool firstRender)
    {
        if (LiveShare.IsActive) LiveShare.ScheduleUpdate(BuildSharePayloadJson());
    }

    // 1人だけ空欄なら合計が合うように自動入力し、条件を満たさなくなったら自動入力を消す
    private void EvaluateAutoFill() => input.EvaluateAutoFill(rules, activeParticipantCount);

    private void NavigateToSettlement()
    {
        NavigationManager.NavigateTo("settlement");
    }

    // セッションを確定して成績に保存する前の確認
    private async Task ConfirmFinalizeSession()
    {
        if (isFinalizing) return;
        isFinalizing = true;
        try
        {
            // ルール名が空、またはプリセットから内容を変えているなら、ルール名を「未設定」にして記録する
            var ruleNameIssue = SessionRecordBuilder.CheckRuleName(rules, await PresetService.GetAsync());
            bool needsRuleNameChange = ruleNameIssue != SessionRecordBuilder.RuleNameIssue.None;
            string msg = "対局結果とチップ枚数を通算成績に記録して<br />現在の入力フォームをリセットしますか？";
            if (ruleNameIssue == SessionRecordBuilder.RuleNameIssue.Empty)
                msg = "<span style='color: var(--mud-palette-warning); font-weight: bold;'>ルール名が未入力です。</span><br /><br />ルール名を「<b>未設定</b>」として<br />" + msg;
            else if (ruleNameIssue == SessionRecordBuilder.RuleNameIssue.ChangedFromPreset)
                msg = $"<span style='color: var(--mud-palette-warning); font-weight: bold;'>ルール名「{rules.Name}」はプリセットから<br />内容が変更されています。</span><br /><br />ルール名を「<b>未設定</b>」として<br />" + msg;
            int chipSum = ActiveSessionChips.Values.Sum();
            bool isChipError = chipSum != 0;
            if (isChipError)
            {
                msg += "<br /><br /><span style='color: #ff6b6b; font-weight: bold;'>※チップの合計枚数が " + (chipSum > 0 ? "+" : "") + chipSum + "枚です。</span>";
            }
            bool? result = await DialogService.ShowMessageBoxAsync(
                "対局セッションの終了確定",
                (MarkupString)msg,
                yesText: needsRuleNameChange ? "「未設定」で記録" : "記録してリセット",
                cancelText: "キャンセル"
            );

            if (result == true)
            {
                if (needsRuleNameChange)
                {
                    rules.Name = "未設定";
                    await SessionState.SaveRulesAsync(rules);
                }
                await FinalizeAndSaveToDbAsync();
            }
        }
        finally
        {
            isFinalizing = false;
        }
    }

    // セッションを確定して成績（IndexedDB）に保存し、入力中の記録を片付ける
    private async Task FinalizeAndSaveToDbAsync()
    {
        try
        {
            var records = SessionRecordBuilder.Build(ActiveHistory, rules, ActiveSessionChips, playerMaster, DateTime.Now);
            playerMaster.AddRange(records.NewPlayers);            await DatabaseService.SaveSessionAsync(records.PlayersToUpdate, records.Session, records.Games);
            if (LiveShare.IsActive) await LiveShare.EndAsync("finished", BuildSharePayloadJson());
            ActiveHistory.Clear();
            ActiveSessionChips.Clear();
            await LocalStorage.SetItemAsync(StorageKeys.ActiveHistory, ActiveHistory);
            await LocalStorage.SetItemAsync(StorageKeys.ActiveSessionChips, ActiveSessionChips);
            ResetInputForms();
            Snackbar.Add("対局結果を通算成績に保存しました！", Severity.Success);
            _ = StatsCache.InitializeAsync(forceReload: true);
            StateHasChanged();
            await SuggestBackupIfNeededAsync();
        }
        catch (Exception ex) { Snackbar.Add("保存中にエラーが発生しました:\n" + ex.Message, Severity.Error); }
    }

    // しばらくバックアップしていなければ、確定のついでに案内する（毎回ダイアログで止めるとしつこいのでスナックバーにする）
    private async Task SuggestBackupIfNeededAsync()
    {
        await CloudBackup.EnsureLoadedAsync();
        if (CloudBackup.IsEnabled) return;
        var lastBackupAt = await DatabaseService.GetLastBackupAtAsync();
        if (lastBackupAt != null && DateTime.Now - lastBackupAt.Value < TimeSpan.FromDays(7)) return;
        string status = lastBackupAt == null ? "成績のバックアップがまだありません" : "しばらくバックアップしていません";
        Snackbar.Add($"{status}\nバックアップしておきませんか？", Severity.Info, config =>
        {
            config.VisibleStateDuration = 8000;
            config.Action = "データ管理へ";
            config.ActionColor = Color.Info;
            config.OnClick = _ =>
            {
                NavigationManager.NavigateTo("settings");
                return Task.CompletedTask;
            };
        });
    }

    // --- テンキー ---
    // 素点の入力でテンキーを開く
    private async Task OpenKeypad(int index)
    {
        if (input.SitOuts[index]) return;
        if (activeChipInputIndex.HasValue) await CloseKeypad();
        bool isAlreadyOpen = activeScoreInputIndex.HasValue;
        if (activeScoreInputIndex.HasValue && activeScoreInputIndex.Value != index)
            await CommitScoreBuffer(activeScoreInputIndex.Value);
        activeScoreInputIndex = index;
        var score = input.Scores[index];
        if (string.IsNullOrEmpty(scoreInputBuffers[index]) && score.HasValue)
            scoreInputBuffers[index] = score.Value.ToString();
        if (!isAlreadyOpen)
        {
            await Task.Delay(50);
            await JSRuntime.InvokeVoidAsync("scrollToInput", "score-input-section");
        }
    }

    // チップの入力でテンキーを開く
    private async Task OpenChipKeypad(int index)
    {
        if (activeScoreInputIndex.HasValue) await CloseKeypad();
        activeChipInputIndex = index;
        var name = TablePlayers[index];
        int currentChip = ActiveSessionChips.TryGetValue(name, out var c) ? c : 0;
        chipInputBuffer = currentChip == 0 ? "" : currentChip.ToString();
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("scrollToInput", "table-wrapper");
    }

    private async Task CloseKeypad(bool saveToStorage = true)
    {
        if (activeScoreInputIndex.HasValue)
            await CommitScoreBuffer(activeScoreInputIndex.Value, saveToStorage);
        if (activeChipInputIndex.HasValue)
        {
            int? finalChip = ScoreExpression.Evaluate(chipInputBuffer);
            var name = TablePlayers[activeChipInputIndex.Value];
            ActiveSessionChips[name] = finalChip ?? 0;
            if (saveToStorage)
                await LocalStorage.SetItemAsync(StorageKeys.ActiveSessionChips, ActiveSessionChips);
            chipInputBuffer = "";
        }
        activeScoreInputIndex = null;
        activeChipInputIndex = null;
        StateHasChanged();
    }

    // 画面の他の場所を押したら、削除の警告表示を解除してテンキーを閉じる
    private async Task OnContainerClick()
    {
        CancelDelete();
        await CloseKeypad();
    }

    // テンキーのキーを押したとき
    private async Task OnKeypadPress(string key)
    {
        if (!activeChipInputIndex.HasValue && !activeScoreInputIndex.HasValue) return;
        if (key == "閉じる") { await CloseKeypad(); return; }

        if (activeChipInputIndex is int chipIdx)
        {
            chipInputBuffer = KeypadInput.Apply(chipInputBuffer, key);
            int? parsed = ScoreExpression.Evaluate(chipInputBuffer);
            var name = TablePlayers[chipIdx];
            ActiveSessionChips[name] = parsed ?? 0;
            StateHasChanged();
            return;
        }
        if (activeScoreInputIndex is int scoreIdx)
        {
            if (key == "記録")
            {
                await CloseKeypad(saveToStorage: false);
                await CalculateAndRecordGame();
                return;
            }
            input.TakeOverAutoFilled(scoreIdx);
            scoreInputBuffers[scoreIdx] = KeypadInput.Apply(scoreInputBuffers[scoreIdx], key);
            EvaluateAutoFill();
        }
    }

    // 入力した式を計算結果に確定する
    private async Task CommitScoreBuffer(int idx, bool saveToStorage = true)
    {
        int? finalScore = ScoreExpression.Evaluate(scoreInputBuffers[idx]);
        if (finalScore.HasValue)
        {
            scoreInputBuffers[idx] = finalScore.Value.ToString();
        }
        else if (!string.IsNullOrWhiteSpace(scoreInputBuffers[idx]))
        {
            scoreInputBuffers[idx] = string.Empty;
        }
        EvaluateAutoFill();
        if (saveToStorage && !isEditing) // 修正中は退避前の途中入力を保存済みのまま残す
        {
            await SessionState.SaveScoreBuffersAsync(scoreInputBuffers);
        }
    }

    // メニューなど入力エリアの外を触ったとき（wwwroot/js/keypad.js から隠しボタン経由で呼ばれる）
    private async Task CloseKeypadOutside()
    {
        if (activeScoreInputIndex.HasValue)
        {
            await CloseKeypad();
            StateHasChanged();
        }
    }
}