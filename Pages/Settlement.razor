@page "/settlement"
@using MahjongApp.Models
@inject MahjongApp.Services.DatabaseService DatabaseService
@inject MahjongApp.Services.SessionStateService SessionStateService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<style>
    /* ページ表示時のフェードインアニメーション */
    .fade-in-content {
        animation: fadeIn 0.4s ease-out forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ヘッダーとデータセルを中央揃えに */
    .settlement-table th,
    .settlement-table td {
        white-space: nowrap;
        text-align: center;
    }

    /* 1列目（名前）は左揃えを維持 */
    .settlement-table th:first-child,
    .settlement-table td:first-child {
        text-align: left;
    }

    /* 数値の桁を揃えるための固定幅ブロック */
    .num-box {
        display: inline-block;
        text-align: right;
        min-width: 5.5em;
        width: max-content;
    }

    .fee-text {
        color: var(--color-negative);
    }

    .unsaved-badge {
        font-size: 0.7rem;
        background-color: var(--mud-palette-warning);
        color: var(--mud-palette-warning-text);
        padding: 2px 6px;
        border-radius: 4px;
        display: inline-block;
        white-space: nowrap;
    }

    /* テンキー表示時のパディング確保 */
    .keypad-open-padding {
        padding-bottom: 350px !important;
    }

    /* 場代入力フィールドのスタイル */
    .fee-input input {
        text-align: center !important;
        font-size: 1.2rem !important;
        font-weight: 500 !important;
    }

    /* 支払いルール選択フィールドのスタイル */
    .rule-select input {
        text-align: center !important;
        font-size: 1.1rem !important;
        font-weight: 500 !important;
    }

    .fee-input-active {
        border: 1px solid #81c784 !important;
        box-shadow: 0 0 6px rgba(129, 199, 132, 0.5);
        background-color: rgba(76, 175, 80, 0.05) !important;
        border-radius: 4px;
    }

    /* 枠付き入力欄のラベルが枠線と重ならないよう、背景で線を隠す */
    .mud-input-label-outlined {
        background-color: var(--mud-palette-surface) !important;
        padding: 0 4px !important;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="@($"mt-4 pb-10 {(isKeypadOpen ? "keypad-open-padding" : "")}")" @onclick="OnContainerClick" Style="min-height: 100vh;">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6" Style="font-family: 'Kaisei Decol', serif; font-weight: bold; color: white; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
        <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Large" Class="mr-2" Style="vertical-align: bottom;" />
        場代清算
    </MudText>

    @* 読み込み中は全体を隠してスピナーを出す *@
    @if (isLoading)
    {
        <div class="d-flex flex-column justify-center align-center" style="height: 50vh; opacity: 0.8;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body2" Class="mt-4" Style="letter-spacing: 2px;">データ読み込み中...</MudText>
        </div>
    }
    else
    {
        <MudGrid Class="fade-in-content">
            @* --- 左カラム: セッションの選択と場代の入力 --- *@
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4 mb-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight: bold;">
                        <MudIcon Icon="@Icons.Material.Filled.Filter1" Size="Size.Small" Class="mr-1" />
                        対象セッションを選択
                    </MudText>
                    @if (allSessions.Count == 0)
                    {
                        <MudText Class="mud-text-secondary" Typo="Typo.body2">記録された対局はありません。</MudText>
                    }
                    else
                    {
                        <div style="max-height: 250px; overflow-y: auto; border: 1px solid var(--mud-palette-divider); border-radius: 4px;">
                            <MudTable Items="@allSessions" MultiSelection="true" @bind-SelectedItems="selectedSessions" Hover="true" Dense="true" Elevation="0" Breakpoint="Breakpoint.None">
                                <RowTemplate>
                                    <MudTd>
                                        <div class="d-flex flex-column gap-1 py-1">
                                            @if (context.IsUnsaved)
                                            {
                                                <div>
                                                    <span class="unsaved-badge">入力中</span>
                                                </div>
                                            }
                                            <div style="font-weight: bold; font-size: 1rem;">
                                                @context.Session.Date.ToString("MM/dd HH:mm")
                                            </div>
                                            <div style="font-size: 0.75rem; color: var(--mud-palette-text-secondary);">
                                                @(context.Games.Count)戦 / @(context.Session.Rules?.Name ?? "カスタム")
                                            </div>
                                        </div>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                </MudPaper>

                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: bold;">
                        <MudIcon Icon="@Icons.Material.Filled.Filter2" Size="Size.Small" Class="mr-1" />
                        場代と支払いルール
                    </MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="5">
                            <div id="fee-input-section" @onclick="OpenKeypad" @onclick:stopPropagation="true">
                                <MudTextField T="string" Value="@(isKeypadOpen ? feeInputBuffer : (totalFee != 0 ? totalFee.ToString("N0") : ""))" Label="@($"場代総額 ({Currency.Unit})")" Variant="Variant.Outlined" ReadOnly="true" Placeholder="0" Class="@($"fee-input {(isKeypadOpen ? "fee-input-active" : "")}")" Style="cursor: pointer;" />
                            </div>
                        </MudItem>
                        <MudItem xs="7">
                            <MudSelect T="FeeRule" @bind-Value="selectedRule" Label="支払いルール" Variant="Variant.Outlined" Class="rule-select">
                                <MudSelectItem T="FeeRule" Value="FeeRule.TopPays">総額トップ払い</MudSelectItem>
                                <MudSelectItem T="FeeRule" Value="FeeRule.TopPerGame">各戦トップ払い</MudSelectItem>
                                <MudSelectItem T="FeeRule" Value="FeeRule.SplitByGames">対戦数比払い</MudSelectItem>
                                <MudSelectItem T="FeeRule" Value="FeeRule.SplitEvenly">同額払い</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            @* --- 右カラム: 精算結果とシェア --- *@
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-0" Outlined="true" Style="overflow: hidden; background-color: var(--mud-palette-surface);">
                    <div style="padding: 24px; border-radius: inherit;">
                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4" Style="font-family: 'Kaisei Decol', serif; font-weight: bold; border-bottom: 1px solid var(--mud-palette-divider); padding-bottom: 8px;">
                            本日の精算結果
                        </MudText>
                        @if (selectedSessions.Count == 0)
                        {
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="mud-text-secondary py-8">
                                セッションを選択してください。
                            </MudText>
                        }
                        else if (calculatedResults.Count == 0)
                        {
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="mud-text-secondary py-8">
                                有効なスコアデータがありません。
                            </MudText>
                        }
                        else
                        {
                            <div style="font-size: 0.85rem; color: var(--mud-palette-text-secondary); margin-bottom: 16px; display: flex; justify-content: space-between;">
                                <span>全 @(selectedSessions.Sum(s => s.Games.Count)) 戦</span>
                                <span>場代: @Currency.Render(totalFee) (@GetRuleName(selectedRule))</span>
                            </div>
                            <div style="overflow-x: auto; overflow-y: auto; max-height: 60vh;">
                                @{
                                    // 列はセッションの日付順にする
                                    var orderedSessions = selectedSessions.OrderBy(s => s.Session.Date).ToList();
                                }
                                <table class="settlement-table" style="width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums;">
                                    <thead>
                                        <tr style="font-size: 0.85rem; color: var(--mud-palette-text-secondary);">
                                            <th style="padding: 8px 4px; position: sticky; top: 0; left: 0; background-color: var(--mud-palette-surface); z-index: 3; border-bottom: 2px solid var(--mud-palette-divider);">名前</th>
                                            <th style="padding: 8px 4px; position: sticky; top: 0; background-color: var(--mud-palette-surface); z-index: 2; border-bottom: 2px solid var(--mud-palette-divider);"><span class="num-box">対戦数</span></th>
                                            @for (int i = 0; i < orderedSessions.Count; i++)
                                            {
                                                <th style="padding: 8px 4px; position: sticky; top: 0; background-color: var(--mud-palette-surface); z-index: 2; border-bottom: 2px solid var(--mud-palette-divider);">
                                                    <span class="num-box">
                                                        @(orderedSessions.Count == 1 ? "収支" : $"収支{GetCircledNumber(i + 1)}")
                                                    </span>
                                                </th>
                                            }
                                            <th style="padding: 8px 4px; position: sticky; top: 0; background-color: var(--mud-palette-surface); z-index: 2; border-bottom: 2px solid var(--mud-palette-divider);"><span class="num-box">場代</span></th>
                                            <th style="padding: 8px 4px; font-size: 0.95rem; color: var(--mud-palette-text-primary); position: sticky; top: 0; background-color: var(--mud-palette-surface); z-index: 2; border-bottom: 2px solid var(--mud-palette-divider);"><span class="num-box">最終収支</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var res in calculatedResults)
                                        {
                                            <tr style="border-bottom: 1px solid var(--mud-palette-divider);">
                                                <td style="padding: 12px 4px; font-weight: bold; font-size: 1.05rem; position: sticky; left: 0; background-color: var(--mud-palette-surface); z-index: 1;">@res.Name</td>
                                                <td style="padding: 12px 4px; color: var(--mud-palette-text-secondary); font-size: 0.8rem;">
                                                    <span class="num-box">@res.GamesPlayed 戦</span>
                                                </td>
                                                @foreach (var os in orderedSessions)
                                                {
                                                    int sYen = res.SessionYen.GetValueOrDefault(os.Session.SessionId, 0);
                                                    <td style="padding: 12px 4px; font-size: 0.9rem;">
                                                        @if (sYen != 0)
                                                        {
                                                            <span class="num-box" style="@GetAmountStyle(sYen)">
                                                                @(sYen > 0 ? "+" : "")@sYen.ToString("N0")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="num-box" style="color: var(--mud-palette-text-disabled);">-</span>
                                                        }
                                                    </td>
                                                }
                                                <td style="padding: 12px 4px; font-size: 0.9rem;">
                                                    <span class="num-box" style="@(res.Fee > 0 ? "color: var(--color-negative);" : (res.Fee < 0 ? "color: var(--color-positive);" : "color: #9e9e9e;"))">
                                                        @(res.Fee > 0 ? "-" : (res.Fee < 0 ? "+" : ""))@(Math.Abs(res.Fee).ToString("N1"))
                                                    </span>
                                                </td>
                                                <td style="padding: 12px 4px; font-weight: bold; font-size: 1.05rem; background-color: rgba(128,128,128,0.05);">
                                                    <span class="num-box" style="@GetAmountStyle(res.FinalAmount)">
                                                        @{
                                                            var parts = Math.Abs(res.FinalAmount).ToString("N1").Split('.');
                                                            string sign = res.FinalAmount > 0 ? "+" : (res.FinalAmount < 0 ? "-" : "");
                                                        }
                                                        @if (Currency.IsPrefix)
                                                        {
                                                            @sign
                                                            @Currency.Unit
                                                            @parts[0]
                                                            <span style="font-size: 0.9em; font-weight: bold; opacity: 0.8;">.@parts[1]</span>
                                                        }
                                                        else
                                                        {
                                                            @sign
                                                            @parts[0]
                                                            <span style="font-size: 0.9em; font-weight: bold; opacity: 0.8;">.@parts[1]@Currency.Unit</span>
                                                        }
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </MudPaper>
                <div class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Image" OnClick="ShareImageAsync" Disabled="@(isSharing || selectedSessions.Count == 0)" Style="font-weight: bold;">
                        @(isSharing ? "生成中..." : "結果を画像でシェア")
                    </MudButton>
                </div>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@* 画像シェア用の精算表（画面のレイアウトに影響しないよう画面外に置く） *@
<div style="position: absolute; left: -9999px; top: 0;">
    <div id="@shareTargetId" style="padding: 24px; background-color: #1a1a27; color: white; border-radius: 12px; width: max-content; min-width: 100%;">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4" Style="font-family: 'Kaisei Decol', serif; font-weight: bold; border-bottom: 1px solid #444; padding-bottom: 8px;">
            本日の精算結果
        </MudText>
        @if (selectedSessions.Count > 0 && calculatedResults.Count > 0)
        {
            <div style="font-size: 0.85rem; color: #aaa; margin-bottom: 16px; display: flex; justify-content: space-between;">
                <span>全 @(selectedSessions.Sum(s => s.Games.Count)) 戦</span>
                <span>場代: @Currency.Render(totalFee) (@GetRuleName(selectedRule))</span>
            </div>
            var orderedSessions = selectedSessions.OrderBy(s => s.Session.Date).ToList();
            <table class="settlement-table" style="width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums;">
                <thead>
                    <tr style="font-size: 0.85rem; color: #bbb;">
                        <th style="padding: 8px 4px; border-bottom: 2px solid #555;">名前</th>
                        <th style="padding: 8px 4px; border-bottom: 2px solid #555;"><span class="num-box">対戦数</span></th>
                        @for (int i = 0; i < orderedSessions.Count; i++)
                        {
                            <th style="padding: 8px 4px; border-bottom: 2px solid #555;">
                                <span class="num-box">
                                    @(orderedSessions.Count == 1 ? "収支" : $"収支{GetCircledNumber(i + 1)}")
                                </span>
                            </th>
                        }
                        <th style="padding: 8px 4px; border-bottom: 2px solid #555;"><span class="num-box">場代</span></th>
                        <th style="padding: 8px 4px; font-size: 0.95rem; color: white; border-bottom: 2px solid #555;"><span class="num-box">最終収支</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in calculatedResults)
                    {
                        <tr style="border-bottom: 1px solid #333;">
                            <td style="padding: 12px 4px; font-weight: bold; font-size: 1.05rem;">@res.Name</td>
                            <td style="padding: 12px 4px; color: #aaa; font-size: 0.8rem;">
                                <span class="num-box">@res.GamesPlayed 戦</span>
                            </td>
                            @foreach (var os in orderedSessions)
                            {
                                int sYen = res.SessionYen.GetValueOrDefault(os.Session.SessionId, 0);
                                <td style="padding: 12px 4px; font-size: 0.9rem;">
                                    @if (sYen != 0)
                                    {
                                        <span class="num-box" style="@GetAmountStyle(sYen)">
                                            @(sYen > 0 ? "+" : "")@sYen.ToString("N0")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="num-box" style="color: #555;">-</span>
                                    }
                                </td>
                            }
                            <td style="padding: 12px 4px; font-size: 0.9rem;">
                                <span class="num-box" style="@(res.Fee > 0 ? "color: var(--color-negative);" : (res.Fee < 0 ? "color: var(--color-positive);" : "color: #9e9e9e;"))">
                                    @(res.Fee > 0 ? "-" : (res.Fee < 0 ? "+" : ""))@(Math.Abs(res.Fee).ToString("N1"))
                                </span>
                            </td>
                            <td style="padding: 12px 4px; font-weight: bold; font-size: 1.05rem; background-color: rgba(255,255,255,0.02);">
                                <span class="num-box" style="@GetAmountStyle(res.FinalAmount)">
                                    @{
                                        var parts = Math.Abs(res.FinalAmount).ToString("N1").Split('.');
                                        string sign = res.FinalAmount > 0 ? "+" : (res.FinalAmount < 0 ? "-" : "");
                                    }
                                    @if (Currency.IsPrefix)
                                    {
                                        @sign
                                        @Currency.Unit
                                        @parts[0]
                                        <span style="font-size: 0.9em; font-weight: bold; opacity: 0.8;">.@parts[1]</span>
                                    }
                                    else
                                    {
                                        @sign
                                        @parts[0]
                                        <span style="font-size: 0.9em; font-weight: bold; opacity: 0.8;">.@parts[1]@Currency.Unit</span>
                                    }
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@* テンキーの外を触ったときに JS から押す隠しボタン（wwwroot/js/keypad.js） *@
<button id="hidden-close-keypad-btn" style="display: none;" @onclick="CloseKeypadOutside"></button>

<ScoreKeypad IsOpen="isKeypadOpen" IsTotalCorrect="true" ShowRecordButton="false" OnKeyPress="OnKeypadPress" />

@code {
    [CascadingParameter] public CurrencySetting Currency { get; set; } = new();
    public enum FeeRule { TopPays, SplitEvenly, TopPerGame, SplitByGames }
    private bool isLoading = true;
    private bool isSharing = false;
    private readonly string shareTargetId = $"settlement-share-{Guid.NewGuid():N}";
    private List<SettlementSessionGroup> allSessions = new();
    private HashSet<SettlementSessionGroup> _selectedSessions = new();
    private HashSet<SettlementSessionGroup> selectedSessions
    {
        get => _selectedSessions;
        set { _selectedSessions = value; CalculateSettlement(); }
    }

    private int _totalFee = 0;
    private int totalFee
    {
        get => _totalFee;
        set
        {
            if (_totalFee != value)
            {
                _totalFee = value;
                _ = SessionStateService.SaveTemporaryFeeAsync(_totalFee);
                CalculateSettlement();
            }
        }
    }

    private FeeRule _selectedRule = FeeRule.SplitEvenly;
    private FeeRule selectedRule
    {
        get => _selectedRule;
        set
        {
            if (_selectedRule != value)
            {
                _selectedRule = value;
                _ = SessionStateService.SaveTemporaryFeeRuleAsync((int)_selectedRule);
                CalculateSettlement();
            }
        }
    }

    private Dictionary<string, string> playerMap = new();
    private List<PlayerResult> calculatedResults = new();

    // --- テンキー ---
    private bool isKeypadOpen = false;
    private string feeInputBuffer = "";

    protected override async Task OnInitializedAsync()
    {
        // 再読み込みや直接表示でも、入力中セッションと場代の入力値を表示できるよう状態を読み込む
        await SessionStateService.InitializeStateAsync();
        _totalFee = SessionStateService.TemporaryTotalFee;
        if (_totalFee != 0)
        {
            feeInputBuffer = _totalFee.ToString();
        }
        _selectedRule = (FeeRule)SessionStateService.TemporaryFeeRule;

        await LoadData();
        CalculateSettlement();
    }

    private async Task LoadData()
    {
        isLoading = true;
        var dbData = await DatabaseService.GetAllDataAsync();

        if (dbData != null)
        {
            var safePlayers = dbData.Players ?? new();
            var safeSessions = dbData.Sessions ?? new();
            var safeGames = dbData.Games ?? new();

            playerMap = safePlayers.Where(p => p != null).ToDictionary(p => p.Id, p => p.Name);

            allSessions = safeSessions
                .Where(s => s != null)
                .OrderByDescending(s => s.Date)
                .Select(s => new SettlementSessionGroup
                {
                    Session = AggregateSessionDuplicates(s),
                    Games = safeGames.Where(g => g != null && g.SessionId == s.SessionId).ToList(),
                    IsUnsaved = false
                }).ToList();
        }

        if (SessionStateService.ActiveHistory != null && SessionStateService.ActiveHistory.Count > 0)
        {
            // 参加者は、局履歴で素点が記録された名前から集める（途中で入れ替わった人のチップも漏らさない。確定保存時と同じ規則）
            var activePlayerNames = new List<string>();
            foreach (var game in SessionStateService.ActiveHistory)
                for (int i = 0; i < game.PlayerNames.Count; i++)
                    if (i < game.RawScores.Count && game.RawScores[i].HasValue)
                    {
                        var name = game.PlayerNames[i];
                        if (!string.IsNullOrWhiteSpace(name) && !activePlayerNames.Contains(name)) activePlayerNames.Add(name);
                    }
            var activePlayerIds = new List<string>();
            foreach (var name in activePlayerNames)
            {
                // 名簿にない名前は、名前そのものを仮のIDにする
                var kv = playerMap.FirstOrDefault(x => x.Value == name);
                string id = kv.Key ?? name;
                activePlayerIds.Add(id);
                if (kv.Key == null) playerMap[name] = name;
            }
            var activeChips = new List<int>();
            foreach (var name in activePlayerNames)
            {
                if (SessionStateService.ActiveSessionChips != null &&
                    SessionStateService.ActiveSessionChips.TryGetValue(name, out int chipValue))
                {
                    activeChips.Add(chipValue);
                }
                else
                {
                    activeChips.Add(0);
                }
            }
            var activeSessionGroup = new SettlementSessionGroup
            {
                Session = new SavedSessionRecord
                {
                    SessionId = "ACTIVE_UNSAVED",
                    Date = DateTime.Now,
                    Rules = SessionStateService.Rules,
                    ParticipantPlayerIds = activePlayerIds,
                    SettledChips = activeChips
                },
                Games = SessionStateService.ActiveHistory.Select(g => new SavedGameRecord
                {
                    SessionId = "ACTIVE_UNSAVED",
                    PlayerIds = g.PlayerNames.Select(name =>
                    {
                        var kv = playerMap.FirstOrDefault(x => x.Value == name);
                        return kv.Key ?? name;
                    }).Cast<string?>().ToList(),
                    Points = g.Points?.ToList() ?? new(),
                    Yen = g.Yen?.ToList() ?? new(),
                    RawScores = g.RawScores?.ToList() ?? new()
                }).ToList(),
                IsUnsaved = true
            };
            activeSessionGroup.Session = AggregateSessionDuplicates(activeSessionGroup.Session);
            allSessions.Insert(0, activeSessionGroup);
            _selectedSessions.Add(activeSessionGroup);
        }
        isLoading = false;
    }

    private void CalculateSettlement()
    {
        calculatedResults.Clear();
        if (selectedSessions == null || selectedSessions.Count == 0) return;

        var map = new Dictionary<string, PlayerResult>();

        foreach (var group in selectedSessions)
        {
            var session = group.Session;
            var sessionId = session.SessionId;
            var rules = session.Rules;
            var pIds = session.ParticipantPlayerIds ?? new();
            var sChips = session.SettledChips ?? new();

            for (int i = 0; i < pIds.Count; i++)
            {
                var pId = pIds[i];
                if (string.IsNullOrEmpty(pId)) continue;
                var res = GetOrAddPlayer(map, pId);

                if (!res.SessionYen.ContainsKey(sessionId)) res.SessionYen[sessionId] = 0;

                if (sChips.Count > i)
                {
                    res.SessionYen[sessionId] += sChips[i] * (rules?.ChipRate ?? 0);
                }
            }

            foreach (var game in group.Games)
            {
                var gPids = game.PlayerIds ?? new();
                var gPts = game.Points ?? new();
                var gYen = game.Yen ?? new();
                var gRaws = game.RawScores ?? new();

                for (int i = 0; i < gPids.Count; i++)
                {
                    var pId = gPids[i];
                    if (string.IsNullOrEmpty(pId)) continue;
                    var res = GetOrAddPlayer(map, pId);

                    if (!res.SessionYen.ContainsKey(sessionId)) res.SessionYen[sessionId] = 0;

                    if (gRaws.Count > i && gRaws[i].HasValue)
                    {
                        res.GamesPlayed++;
                        res.TotalPt += gPts.Count > i ? gPts[i] : 0;
                        res.SessionYen[sessionId] += gYen.Count > i ? gYen[i] : 0;
                    }
                }
            }
        }
        var activePlayers = map.Values.Where(p => p.GamesPlayed > 0 || p.TotalMahjongYen != 0).ToList();
        if (activePlayers.Count == 0) return;
        double fee = totalFee;
        if (selectedRule == FeeRule.TopPays)
        {
            // 小数の計算誤差で同点を取りこぼさないよう、表示と同じ小数第1位で比較する
            double maxPt = Math.Round(activePlayers.Max(p => p.TotalPt), 1);
            var topPlayers = activePlayers.Where(p => Math.Round(p.TotalPt, 1) == maxPt).ToList();
            double splitFee = fee / topPlayers.Count;
            foreach (var p in topPlayers) p.Fee = splitFee;
        }
        else if (selectedRule == FeeRule.TopPerGame)
        {
            int validGamesCount = 0;
            var gameTops = new List<List<PlayerResult>>();
            foreach (var group in selectedSessions)
            {
                foreach (var game in group.Games)
                {
                    var gPids = game.PlayerIds ?? new();
                    var gRaws = game.RawScores ?? new();
                    var gPts = game.Points ?? new();
                    double maxScore = double.MinValue;
                    var currentTopPlayers = new List<PlayerResult>();
                    for (int i = 0; i < gPids.Count; i++)
                    {
                        var pId = gPids[i];
                        if (string.IsNullOrEmpty(pId)) continue;
                        double? score = null;
                        if (i < gPts.Count && gPts[i] is { } pt) score = Math.Round(pt, 1);
                        if (score.HasValue)
                        {
                            if (score.Value > maxScore)
                            {
                                maxScore = score.Value;
                                currentTopPlayers.Clear();
                                if (map.TryGetValue(pId, out var pr)) currentTopPlayers.Add(pr);
                            }
                            else if (score.Value == maxScore)
                            {
                                if (map.TryGetValue(pId, out var pr)) currentTopPlayers.Add(pr);
                            }
                        }
                    }
                    if (currentTopPlayers.Count > 0)
                    {
                        validGamesCount++;
                        gameTops.Add(currentTopPlayers);
                    }
                }
            }
            if (validGamesCount > 0)
            {
                double feePerGame = fee / validGamesCount;
                foreach (var tops in gameTops)
                {
                    double splitFee = feePerGame / tops.Count;
                    foreach (var p in tops)
                    {
                        p.Fee += splitFee;
                    }
                }
            }
        }
        else if (selectedRule == FeeRule.SplitByGames)
        {
            int totalGames = activePlayers.Sum(p => p.GamesPlayed);
            if (totalGames > 0)
            {
                foreach (var p in activePlayers)
                {
                    p.Fee = fee * ((double)p.GamesPlayed / totalGames);
                }
            }
        }
        else if (selectedRule == FeeRule.SplitEvenly)
        {
            double splitFee = fee / activePlayers.Count;
            foreach (var p in activePlayers) p.Fee = splitFee;
        }
        calculatedResults = activePlayers.OrderByDescending(p => p.FinalAmount).ToList();
    }

    // 1〜20 は丸数字（①〜⑳）にする
    private string GetCircledNumber(int number)
    {
        if (number >= 1 && number <= 20)
        {
            return "①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳"[number - 1].ToString();
        }
        return $"({number})";
    }

    private PlayerResult GetOrAddPlayer(Dictionary<string, PlayerResult> map, string pId)
    {
        if (!map.TryGetValue(pId, out var res))
        {
            res = new PlayerResult
            {
                Id = pId,
                Name = playerMap.TryGetValue(pId, out var name) ? name : "不明"
            };
            map[pId] = res;
        }
        return res;
    }

    private async Task ShareImageAsync()
    {
        isSharing = true;
        StateHasChanged();
        await Task.Delay(100);
        try
        {
            var result = await JSRuntime.InvokeAsync<string>("exportAndShareResult", shareTargetId);
            if (result == "COPIED") Snackbar.Add("精算表をクリップボードにコピーしました", Severity.Success);
            else if (result == "DOWNLOADED") Snackbar.Add("精算表をダウンロードしました", Severity.Info);
            else if (result.StartsWith("ERROR")) Snackbar.Add($"画像の生成に失敗しました:\n{result}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("シェア処理中にエラーが発生しました", Severity.Error);
        }
        finally
        {
            isSharing = false;
            StateHasChanged();
        }
    }

    // --- テンキー操作 ---

    private void OnContainerClick()
    {
        if (isKeypadOpen)
        {
            CloseKeypad();
        }
    }

    private void CloseKeypadOutside()
    {
        if (isKeypadOpen)
        {
            CloseKeypad();
            StateHasChanged();
        }
    }

    private async Task OpenKeypad()
    {
        if (isKeypadOpen) return;
        isKeypadOpen = true;
        feeInputBuffer = totalFee == 0 ? "" : totalFee.ToString();
        StateHasChanged();
        await Task.Delay(150);
        await JSRuntime.InvokeVoidAsync("scrollToCenter", "fee-input-section");
    }

    private void CloseKeypad()
    {
        isKeypadOpen = false;
        // 閉じたら式を計算結果に置き換える（例: 「1000-500」→「500」）
        feeInputBuffer = totalFee == 0 ? "" : totalFee.ToString();
    }

    private void OnKeypadPress(string key)
    {
        if (!isKeypadOpen) return;

        if (key == "閉じる" || key == "記録")
        {
            CloseKeypad();
            return;
        }

        if (key == "C")
        {
            feeInputBuffer = "";
        }
        else if (key == "⌫" || key == "戻る")
        {
            if (feeInputBuffer.Length > 0) feeInputBuffer = feeInputBuffer[..^1];
        }
        else if (key == "+" || key == "-")
        {
            // 符号が続いたら、後から押した符号で置き換える
            if (feeInputBuffer.EndsWith('+') || feeInputBuffer.EndsWith('-'))
            {
                feeInputBuffer = feeInputBuffer[..^1];
            }
            feeInputBuffer += key;
        }
        else
        {
            // 数字の先頭の余分な0は消す
            feeInputBuffer += key;
            feeInputBuffer = System.Text.RegularExpressions.Regex.Replace(feeInputBuffer, @"(^|[-+])0+(?=[0-9])", "$1");
        }

        int? parsed = EvaluateScoreExpression(feeInputBuffer);
        totalFee = parsed ?? 0; // setter で精算結果も再計算される
    }

    // 足し算・引き算の式を計算する。式として読めなければ null
    private int? EvaluateScoreExpression(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return null;
        input = input.Replace(" ", "").Replace("　", "");
        try
        {
            int total = 0;
            string currentNumber = "";
            char currentOp = '+';
            for (int i = 0; i < input.Length; i++)
            {
                char c = input[i];
                if (c == '+' || c == '-')
                {
                    if (string.IsNullOrEmpty(currentNumber))
                    {
                        currentOp = c == '-' && currentOp == '+' ? '-' : c;
                        continue;
                    }
                    int val = int.Parse(currentNumber);
                    total = currentOp == '+' ? total + val : total - val;
                    currentNumber = "";
                    currentOp = c;
                }
                else if (char.IsDigit(c))
                {
                    currentNumber += c;
                }
                else
                {
                    return null;
                }
            }
            if (!string.IsNullOrEmpty(currentNumber))
            {
                int val = int.Parse(currentNumber);
                total = currentOp == '+' ? total + val : total - val;
            }
            return total;
        }
        catch
        {
            return null;
        }
    }

