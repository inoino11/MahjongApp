@page "/settings"
@using Microsoft.AspNetCore.Components.Forms
@inject MahjongApp.Services.DatabaseService DatabaseService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject MahjongApp.Services.StatsCacheService StatsCache
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject MahjongApp.Services.CloudBackupService CloudBackup
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4 pb-10">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6" Style="font-family: 'Kaisei Decol', serif; font-weight: bold; color: white; text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">
        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" Class="mr-2" Style="vertical-align: bottom;" />
        データ管理
    </MudText>
    @* クラウドバックアップ *@
    <MudPaper Class="pa-6 mb-6" Outlined="true" Style="border-color: var(--mud-palette-success);">
        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Success">クラウドバックアップ</MudText>
        @if (CloudBackup.TakenOver)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="DismissTakenOver">
                別の端末にバックアップが引き継がれたため、この端末のバックアップを停止しました。
            </MudAlert>
        }
        @if (!CloudBackup.IsEnabled)
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                成績を自動でクラウドに保存し、機種変更やデータが消えたときに戻せるようにします。<br />
                データはこの端末で暗号化してから送るため、サーバー側では中身を読めません。<br />
                <span style="color: var(--mud-palette-warning); font-weight: bold;">復元には「復元キー」が必要です。なくすと誰にも復元できません。</span>
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="EnableCloudBackup" Disabled="isCloudBusy">
                @(isCloudBusy ? "準備中..." : "クラウドバックアップを始める")
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-1">
                成績が変わると自動で保存します（間隔は最短10分）。
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-1" Style="@(CloudBackup.HasError ? "color: var(--mud-palette-error);" : "")">
                @CloudStatusText
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-4">
                @if (CloudBackup.PasskeyRegistered)
                {
                    <span>復元キーはパスキーにも保存済みです。</span>
                }
                else if (passkeySupported)
                {
                    <span style="color: var(--mud-palette-warning);">パスキーに保存しておくと、キーを控えていなくても顔認証や指紋認証で復元できます。</span>
                }
            </MudText>
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudSync" OnClick="BackupNow" Disabled="@(isCloudBusy || CloudBackup.IsSending)">今すぐバックアップ</MudButton>
                @if (passkeySupported && !CloudBackup.PasskeyRegistered)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Fingerprint" OnClick="RegisterPasskey" Disabled="isCloudBusy">パスキーに保存</MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Key" OnClick="ShowRecoveryKey">復元キーを表示</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudOff" OnClick="DisableCloudBackup" Disabled="isCloudBusy">停止する</MudButton>
            </div>
        }
    </MudPaper>
    @* バックアップ *@
    <MudPaper Class="pa-6 mb-6" Outlined="true" Style="border-color: var(--mud-palette-info);">
        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Info">ファイルでバックアップ</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            対局履歴、名簿およびルールプリセットを<br />
            JSONファイルとしてダウンロードします。
        </MudText>
        @* データが消える操作の注意 *@
        <MudAlert Severity="Severity.Normal" Icon="@Icons.Material.Filled.Lightbulb" Class="mb-4 pa-3" Style="font-size: 0.8rem; line-height: 1.5; background-color: rgba(41, 182, 246, 0.05);">
            <div style="font-weight: bold; margin-bottom: 4px;">データ保存に関するTips</div>
            @if (!envInfo.IsPwa)
            {
                @* Web *@
                <div>
                    データは現在のブラウザに保存されています。<br />
                    以下の操作でデータが消去されるため、<br />
                    事前のバックアップを推奨します。<br />
                    <ul style="margin-top: 4px; margin-bottom: 0; padding-left: 20px;">
                        @if (envInfo.IsIOS)
                        {
                            <li>「履歴と Web サイトデータを消去」</li>
                        }
                        else
                        {
                            <li>「Cookie とサイトデータ」の削除（キャッシュだけの削除なら残ります）</li>
                        }
                        <li>プライベートモードでの利用終了</li>
                        <li>機種変更や別ブラウザへの移行</li>
                    </ul>
                </div>
                <div style="margin-top: 8px; color: var(--mud-palette-warning); font-weight: bold;">
                    @if (envInfo.IsIOS)
                    {
                        @* iOS *@
                        <span>
                            「ホーム画面に追加」してアプリ化する場合、<br /><span style="color: var(--mud-palette-error);">
                            ブラウザのデータはアプリに引き継がれません。</span><br />
                            事前にバックアップを保存し、アプリ側で復元してください。
                        </span>
                    }
                    else
                    {
                        @* Android *@
                        <span>
                            「アプリとして追加」でアプリ化できます。<br />
                            ブラウザのデータはアプリに引き継がれます。
                        </span>
                    }
                </div>
            }
            else
            {
                @* PWA *@
                <div style="margin-top: 8px; color: var(--mud-palette-normal); font-weight: bold;">
                    @if (envInfo.IsIOS)
                    {
                        @* iOS *@
                        <span>
                            ホーム画面からアプリを削除すると<br />
                            データも消えます。<br />
                            Safari の「履歴と Web サイトデータを消去」でも<br />
                            消える場合があるため、バックアップを推奨します。
                        </span>
                    }
                    else if (envInfo.IsAndroid)
                    {
                        @* Android *@
                        <span>
                            アプリのデータはインストール元のブラウザと<br />
                            共有されています。<br />
                            ブラウザの「Cookie とサイトデータ」を削除すると<br />
                            データも消えます（キャッシュだけの削除なら残ります）。
                        </span>
                    }
                    else
                    {
                        @* Windowsなど *@
                        <span>
                            ブラウザのキャッシュやサイトデータをクリアすると<br />
                            アプリのデータも消える可能性があります。
                        </span>
                    }
                </div>
            }
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportData">
            バックアップファイルを保存
        </MudButton>
        @if (lastBackupAt == null)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2" Style="color: var(--mud-palette-warning); font-weight: bold;">まだバックアップしていません</MudText>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2">最後のバックアップ: @FormatElapsed(lastBackupAt.Value)</MudText>
        }
    </MudPaper>
    @* 復元・統合 *@
    <MudPaper Class="pa-6 mb-6" Outlined="true" Style="border-color: var(--mud-palette-warning);">
        <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Warning">データの復元・統合</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            バックアップされたJSONファイルを<br />
            読み込みます。
        </MudText>
        <MudRadioGroup @bind-Value="importMode" Class="mb-4 d-flex flex-column">
            <MudRadio Value='"overwrite"' Color="Color.Error">
                <strong>完全上書き</strong><br />(データを消去して入れ替えます。<br />ルールが含まれないバックアップなら、今のルールは残します)
            </MudRadio>
            <MudRadio Value='"merge"' Color="Color.Success">
                <strong>データ統合</strong><br />(データに差分を追加します。<br />同じ内容のルールは重複させません)
            </MudRadio>
        </MudRadioGroup>
        <div class="d-flex flex-wrap gap-2">
            <MudButton HtmlTag="label" for="backup-upload" Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Upload">
                ファイルを選択して実行
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.CloudDownload" OnClick="RestoreFromCloud">
                クラウドから復元
            </MudButton>
        </div>
        <InputFile id="backup-upload" OnChange="ImportData" accept=".json" style="display: none;" />
    </MudPaper>
    @* 全データ初期化 *@
    <MudPaper Class="pa-6" Outlined="true" Style="border-color: var(--mud-palette-error);">
        <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-2">⚠️データの初期化</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            対局履歴、名簿およびルールプリセットを<br />
            完全に削除します。<br />
            事前のバックアップをお勧めします。<br />
            ※クラウドバックアップは残り、復元キーで戻せます。
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="ConfirmWipeAllData">
            全データを初期化する
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string importMode = "merge"; // "merge": 統合 / "overwrite": 完全上書き
    private bool isCloudBusy = false;
    private bool passkeySupported = false;

    protected override async Task OnInitializedAsync()
    {
        await CloudBackup.EnsureLoadedAsync();
        CloudBackup.OnChanged += HandleCloudChanged;
    }

    private void HandleCloudChanged() => InvokeAsync(async () =>
    {
        lastBackupAt = await DatabaseService.GetLastBackupAtAsync();
        StateHasChanged();
    });

    public void Dispose() => CloudBackup.OnChanged -= HandleCloudChanged;

    // OS と PWA かどうかで案内文を切り替える
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            envInfo = await JSRuntime.InvokeAsync<EnvironmentInfo>("pwaHelper.getEnvironmentInfo");
            lastBackupAt = await DatabaseService.GetLastBackupAtAsync();
            passkeySupported = await CloudBackup.IsPasskeySupportedAsync();
            StateHasChanged();
        }
    }

    // --- クラウドバックアップ ---
    private string CloudStatusText
    {
        get
        {
            if (CloudBackup.IsSending) return "送信中...";
            if (CloudBackup.HasError) return CloudBackup.LastError ?? "送信に失敗しました";
            string last = CloudBackup.LastSuccessAt == null ? "まだ送信していません" : $"最後の保存: {FormatElapsed(CloudBackup.LastSuccessAt.Value)}";
            return CloudBackup.IsPending ? $"{last}（未送信の変更があります）" : last;
        }
    }

    private async Task EnableCloudBackup()
    {
        isCloudBusy = true;
        try
        {
            string recoveryKey = await CloudBackup.EnableAsync();
            Snackbar.Add("クラウドバックアップを始めました", Severity.Success);
            await ShowRecoveryKeyDialogAsync(recoveryKey, isFirstTime: true);
            if (passkeySupported)
            {
                bool? usePasskey = await DialogService.ShowMessageBoxAsync(
                    "パスキーにも保存",
                    (MarkupString)"復元キーをパスキーにも保存しますか？<br />キーを控えていなくても、機種変更後に顔認証や指紋認証で復元できます。",
                    yesText: "保存する", cancelText: "あとで");
                if (usePasskey == true)
                {
                    isCloudBusy = false;
                    await RegisterPasskey();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"クラウドバックアップを始められませんでした:\n{ex.Message}", Severity.Error);
        }
        finally
        {
            isCloudBusy = false;
        }
    }

    private async Task BackupNow()
    {
        bool ok = await CloudBackup.BackupNowAsync();
        if (ok) Snackbar.Add("クラウドに保存しました", Severity.Success);
        else if (CloudBackup.TakenOver) Snackbar.Add("別の端末に引き継がれたため、停止しました", Severity.Warning);
        else Snackbar.Add(CloudBackup.LastError ?? "送信に失敗しました", Severity.Error);
    }

    private async Task RegisterPasskey()
    {
        isCloudBusy = true;
        try
        {
            var result = await CloudBackup.RegisterPasskeyAsync();
            switch (result.Status)
            {
                case "OK":
                    Snackbar.Add("復元キーをパスキーに保存しました", Severity.Success);
                    break;
                case "UNSUPPORTED":
                    passkeySupported = false;
                    Snackbar.Add("この端末のパスキーは、復元キーの保存に対応していません\n復元キーを控えておいてください", Severity.Warning);
                    break;
                case "CANCELED":
                    break;
                default:
                    Snackbar.Add($"パスキーに保存できませんでした:\n{result.Message}", Severity.Error);
                    break;
            }
        }
        finally
        {
            isCloudBusy = false;
        }
    }

    private async Task ShowRecoveryKey()
    {
        if (CloudBackup.RecoveryKey != null) await ShowRecoveryKeyDialogAsync(CloudBackup.RecoveryKey, isFirstTime: false);
    }

    private async Task ShowRecoveryKeyDialogAsync(string recoveryKey, bool isFirstTime)
    {
        var parameters = new DialogParameters<Components.RecoveryKeyDialog>
        {
            { x => x.RecoveryKey, recoveryKey },
            { x => x.IsFirstTime, isFirstTime }
        };
        // 初めて発行したときは、控える前に閉じてしまわないよう「控えました」でしか閉じられなくする
        var options = new DialogOptions { BackdropClick = !isFirstTime, CloseOnEscapeKey = !isFirstTime, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Components.RecoveryKeyDialog>(null, parameters, options);
        await dialog.Result;
    }

    private async Task DisableCloudBackup()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "クラウドバックアップの停止",
            (MarkupString)"クラウド上のバックアップを削除し、自動保存を止めます。<br />この端末の成績はそのまま残ります。<br />よろしいですか？",
            yesText: "停止する", cancelText: "キャンセル");
        if (result != true) return;
        isCloudBusy = true;
        try
        {
            await CloudBackup.DisableAsync();
            Snackbar.Add("クラウドバックアップを停止しました", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"停止できませんでした:\n{ex.Message}", Severity.Error);
        }
        finally
        {
            isCloudBusy = false;
        }
    }

    private async Task DismissTakenOver() => await CloudBackup.DismissTakenOverAsync();

    private async Task RestoreFromCloud()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Components.CloudRestoreDialog>(null, options);
        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not Components.CloudRestoreDialog.Selection selection) return;

        bool isMerge = importMode == "merge";
        string when = selection.Generation.At.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
        string message = isMerge
            ? $"{when} 時点のバックアップを、現在のデータに追加・統合します。<br />以後はこの端末でバックアップを続けます。<br />よろしいですか？"
            : $"現在のデータをすべて消去し、{when} 時点のバックアップで置き換えます。<br />以後はこの端末でバックアップを続けます。<br />よろしいですか？";
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            isMerge ? "クラウドから統合" : "クラウドから完全上書き", (MarkupString)message,
            yesText: "はい、実行します", cancelText: "キャンセル");
        if (confirmed != true) return;
        try
        {
            var presetResult = await CloudBackup.RestoreAsync(selection.RecoveryKey, selection.Listing, selection.Generation, isMerge);
            _ = StatsCache.InitializeAsync(forceReload: true);
            ShowRestoreResult(isMerge, presetResult);
            await Task.Delay(RestoreMessageDelay);
            NavigationManager.NavigateTo(NavigationManager.BaseUri, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"復元に失敗しました:\n{ex.Message}", Severity.Error);
        }
    }

    private EnvironmentInfo envInfo = new();
    private DateTime? lastBackupAt;

    private static string FormatElapsed(DateTime at)
    {
        var days = (DateTime.Now.Date - at.Date).Days;
        string when = days switch
        {
            <= 0 => "今日",
            1 => "昨日",
            _ => $"{days}日前"
        };
        return $"{when}（{at:yyyy/MM/dd HH:mm}）";
    }

    private async Task ExportData()
    {
        try
        {
            string result = await DatabaseService.ExportDataAsync();
            lastBackupAt = await DatabaseService.GetLastBackupAtAsync();
            if (result == "SHARED")
            {
                Snackbar.Add("バックアップファイルをシェアしました", Severity.Success);
            }
            else if (result == "DOWNLOADED")
            {
                Snackbar.Add("バックアップファイルをダウンロードしました", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エクスポートに失敗しました:\n{ex.Message}", Severity.Error);
        }
    }

    private async Task ImportData(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        bool isMerge = importMode == "merge";
        string title = isMerge ? "データの統合" : "データの完全上書き";
        string message = isMerge
            ? "現在のデータにバックアップファイルのデータを追加・統合します。\n（同じ対局が含まれている場合は、バックアップ側の内容で上書きされます）\n本当によろしいですか？"
            : "現在のアプリ内のデータはすべて消去され、選択したファイルの内容で上書きされます。\n本当によろしいですか？";
        bool? result = await DialogService.ShowMessageBoxAsync(
            title, message, yesText: "はい、実行します", cancelText: "キャンセル");
        if (result != true) return;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            // DBに入れる前に、バックアップファイルの形式かどうかを確認する
            try
            {
                var options = new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                };
                var testParse = System.Text.Json.JsonSerializer.Deserialize<MahjongApp.Services.AllDbData>(json, options);
                if (testParse == null || (testParse.Players == null && testParse.Games == null && testParse.RulePresets == null) || !HasRequiredKeys(json))
                {
                    Snackbar.Add("ファイル形式が正しくありません\nTaGAMΣ のバックアップファイルを選んでください", Severity.Error);
                    return;
                }
            }
            catch (System.Text.Json.JsonException)
            {
                Snackbar.Add("ファイルを読み取れませんでした\nバックアップファイルではない可能性があります", Severity.Error);
                return;
            }
            var presetResult = await DatabaseService.ImportDataAsync(json, isMerge);
            _ = StatsCache.InitializeAsync(forceReload: true);
            ShowRestoreResult(isMerge, presetResult);
            await Task.Delay(RestoreMessageDelay);
            NavigationManager.NavigateTo(NavigationManager.BaseUri, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"ファイルの読み込み処理中にエラーが発生しました:\n{ex.Message}", Severity.Error);
        }
    }

    // 復元の完了を、ルールプリセットの取り込み結果と一緒に知らせる（読めるよう、再読み込みまで少し待つ）
    private const int RestoreMessageDelay = 2500;

    private void ShowRestoreResult(bool isMerge, MahjongApp.Services.RulePresetService.ImportResult preset)
    {
        string done = isMerge ? "データを統合しました！" : "データを復元しました！";
        void Show(string message, Severity severity) => Snackbar.Add(message, severity, config => config.VisibleStateDuration = RestoreMessageDelay + 1000);
        if (preset.Error != null)
        {
            Show($"{done}\nただし、ルールの取り込みに失敗しました:\n{preset.Error}", Severity.Warning);
            return;
        }
        var parts = new List<string>();
        if (preset.Added > 0) parts.Add(isMerge ? $"{preset.Added}件追加" : $"{preset.Added}件");
        if (preset.Skipped > 0) parts.Add($"{preset.Skipped}件は同じ内容のため省略");
        string detail = parts.Count > 0 ? $"\nルール: {string.Join("、", parts)}" : "";
        if (preset.Unreadable > 0)
            Show($"{done}{detail}\n読み取れないルールが{preset.Unreadable}件ありました", Severity.Warning);
        else
            Show(done + detail, Severity.Success);
    }

    // IndexedDB の主キー（players.id / sessions.sessionId / games.id）が全件にあるか確認する。
    // 欠けているとDBへの書き込みが途中で失敗するため、取り込む前に弾く
    private static bool HasRequiredKeys(string json)
    {
        using var doc = System.Text.Json.JsonDocument.Parse(json);
        var root = doc.RootElement;
        if (root.ValueKind != System.Text.Json.JsonValueKind.Object) return false;
        bool AllHaveKey(string arrayName, string keyName)
        {
            if (!root.TryGetProperty(arrayName, out var array) || array.ValueKind == System.Text.Json.JsonValueKind.Null) return true;
            if (array.ValueKind != System.Text.Json.JsonValueKind.Array) return false;
            return array.EnumerateArray().All(item =>
                item.ValueKind == System.Text.Json.JsonValueKind.Object &&
                item.TryGetProperty(keyName, out var key) &&
                key.ValueKind == System.Text.Json.JsonValueKind.String &&
                !string.IsNullOrEmpty(key.GetString()));
        }
        return AllHaveKey("players", "id") && AllHaveKey("sessions", "sessionId") && AllHaveKey("games", "id");
    }

    // 誤操作を防ぐため2回確認してから全データを消す
    private async Task ConfirmWipeAllData()
    {
        bool? result1 = await DialogService.ShowMessageBoxAsync(
            "全データの初期化",
            (MarkupString)"すべての対局履歴、名簿およびルールプリセットを消去します。<br />よろしいですか？",
            yesText: "はい、消去します", cancelText: "キャンセル");
        if (result1 == true)
        {
            bool? result2 = await DialogService.ShowMessageBoxAsync(
                "最終確認",
                (MarkupString)"本当にすべてのデータを消去しますか？",
                yesText: "はい、消去します", cancelText: "キャンセル");
            if (result2 == true)
            {
                CloudBackup.ForgetOnThisDevice();
                await DatabaseService.ClearAllDataAsync();
                await LocalStorage.ClearAsync();
                _ = StatsCache.InitializeAsync(forceReload: true);
                Snackbar.Add("すべてのデータを初期化しました", Severity.Success);
                await Task.Delay(1500);
                NavigationManager.NavigateTo(NavigationManager.BaseUri, forceLoad: true);
            }
        }
    }
}